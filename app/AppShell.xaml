<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="app.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:app"
    Title="app">

    <ShellContent
        Title="Formulario"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent 
        Title="Home"
        ContentTemplate="{DataTemplate local:HomePage}"
        Route="HomePage"
        />
    <ShellContent 
        Title="crearperfil"
        ContentTemplate="{DataTemplate local:crearPerfil}"
        Route="crearPerfil"
        />
    <ShellContent 
        Title="Retos"
        ContentTemplate="{DataTemplate local:RetosPage}"
        Route="RetosPage"
        />
    <ShellContent 
        Title="Nutricion"
        ContentTemplate="{DataTemplate local:NutricionPage}"
        Route="NutricionPage"
        />
    <ShellContent 
        Title="Ciclo Menstrual"
        ContentTemplate="{DataTemplate local:MenstrualPage}"
        Route="MenstrualPage"
        />
    <ShellContent 
        Title="Registro de Actividad"
        ContentTemplate="{DataTemplate local:RegistroActividadPage}"
        Route="RegistroActividadPage"
        />
    <ShellContent 
        Title="Estado Anímico"
        ContentTemplate="{DataTemplate local:EstadoAnimicoPage}"
        Route="EstadoAnimicoPage"
        />

</Shell>
