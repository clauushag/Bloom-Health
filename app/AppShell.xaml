<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="app.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:app"
    Title="app">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage"/>

    <ShellContent
        Title="Crear Perfil"
        ContentTemplate="{DataTemplate local:crearPerfil}"
        Route="crearPerfil"/>
    <ShellContent
        Title="RetosPage"
        ContentTemplate="{DataTemplate local:RetosPage}"
        Route="RetosPage"/>
    <ShellContent
        Title="Menstrual"
        ContentTemplate="{DataTemplate local:MenstrualPage}"
        Route="MenstrualPage"/>
    <ShellContent
        Title="Nutricion"
        ContentTemplate="{DataTemplate local:NutricionPage}"
        Route="NutricionPage"/>
    <ShellContent
        Title="Perfil"
        ContentTemplate="{DataTemplate local:PerfilPage}"
        Route="PerfilPage"/>





</Shell>
