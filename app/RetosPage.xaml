<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app.RetosPage"
             BackgroundColor="{AppThemeBinding Light=#F7F9F7, Dark=#121212}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, 70">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20" Padding="25,50,25,20">

                <!-- CABECERA -->
                <Label Text="Retos"
                       FontSize="24" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                <Label Text="Acepta retos y completa tus objetivos"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                       Margin="0,-15,0,0"/>

                <!-- RESUMEN -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Frame Grid.Column="0"
                           BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#1A2E1C}"
                           CornerRadius="16" HasShadow="False"
                           BorderColor="Transparent" Padding="10,12">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="✅" FontSize="18" HorizontalOptions="Center"/>
                            <Label x:Name="LabelCompletados" Text="0"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="#8EB497" HorizontalOptions="Center"/>
                            <Label Text="Completados" FontSize="10"
                                   TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="1"
                           BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#2E2A1A}"
                           CornerRadius="16" HasShadow="False"
                           BorderColor="Transparent" Padding="10,12">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="⚡" FontSize="18" HorizontalOptions="Center"/>
                            <Label x:Name="LabelEnProgreso" Text="0"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="#F5C842" HorizontalOptions="Center"/>
                            <Label Text="En progreso" FontSize="10"
                                   TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="2"
                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                           CornerRadius="16" HasShadow="False"
                           BorderColor="Transparent" Padding="10,12">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="🔒" FontSize="18" HorizontalOptions="Center"/>
                            <Label x:Name="LabelPendientes" Text="0"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#666666}"
                                   HorizontalOptions="Center"/>
                            <Label Text="Pendientes" FontSize="10"
                                   TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- LISTA DE RETOS -->
                <CollectionView x:Name="RetosCollectionView"
                                RemainingItemsThreshold="3"
                                RemainingItemsThresholdReached="OnRetosThresholdReached">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                   CornerRadius="16" HasShadow="True"
                                   BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                                   Padding="15" Margin="0,0,0,10">
                                <Frame.Shadow>
                                    <Shadow Brush="#A0AF9E" Offset="0,4"
                                            Radius="10" Opacity="0.08"/>
                                </Frame.Shadow>
                                <VerticalStackLayout Spacing="8">

                                    <!-- Fila superior: emoji + nombre + puntos -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0"
                                               Text="{Binding EmojiCategoria}"
                                               FontSize="24" VerticalOptions="Center"/>
                                        <VerticalStackLayout Grid.Column="1"
                                                             VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Nombre}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                            <Label Text="{Binding NombreCategoria}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                        </VerticalStackLayout>
                                        <Frame Grid.Column="2"
                                               BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#1A2E1C}"
                                               CornerRadius="12" HasShadow="False"
                                               BorderColor="Transparent"
                                               Padding="8,4" VerticalOptions="Center">
                                            <Label Text="{Binding Puntos_Recompensa, StringFormat='+{0} XP'}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="#8EB497"/>
                                        </Frame>
                                    </Grid>

                                    <!-- Descripción -->
                                    <Label Text="{Binding Descripcion}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>

                                    <!-- Barra de progreso -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <ProgressBar Grid.Column="0"
                                                     Progress="{Binding PorcentajeProgreso}"
                                                     ProgressColor="#8EB497"
                                                     BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#2C3C2C}"
                                                     VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding TextoProgreso}"
                                               FontSize="10"
                                               TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                               VerticalOptions="Center"/>
                                    </Grid>

                                    <!-- Botón acción -->
                                    <Button Text="{Binding TextoBoton}"
                                            Clicked="OnAceptarRetoClicked"
                                            BackgroundColor="{Binding ColorEstado}"
                                            TextColor="White"
                                            FontSize="13" FontAttributes="Bold"
                                            CornerRadius="20" HeightRequest="38"
                                            IsEnabled="{Binding EstaPendiente}"/>

                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BARRA NAVEGACIÓN -->
        <Frame Grid.Row="1"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
               CornerRadius="0" Padding="10,6" HasShadow="False"
               BorderColor="{AppThemeBinding Light=#EEF2EE, Dark=#3C3C3C}">
            <Grid ColumnDefinitions="*, *, *"
                  MaximumWidthRequest="800" HorizontalOptions="FillAndExpand">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInicioTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="🏠" FontSize="20" HorizontalOptions="Center"/>
                    <Label Text="Inicio" FontSize="11" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRetosTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="🏆" FontSize="20" HorizontalOptions="Center"/>
                    <Label Text="Retos" FontSize="11" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPerfilTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="👤" FontSize="20" HorizontalOptions="Center"/>
                    <Label Text="Perfil" FontSize="11" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                </VerticalStackLayout>
            </Grid>
        </Frame>

    </Grid>
</ContentPage>