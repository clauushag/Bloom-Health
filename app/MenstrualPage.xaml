<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app.MenstrualPage"
             BackgroundColor="{AppThemeBinding Light=#F7F9F7, Dark=#121212}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <Frame Grid.Row="0"
               BackgroundColor="#F29EBB"
               Padding="25,50,25,20"
               CornerRadius="0"
               HasShadow="False"
               BorderColor="Transparent">
            <Grid ColumnDefinitions="Auto, *">
                <Label Grid.Column="0"
                       Text="←" FontSize="26" TextColor="White"
                       VerticalOptions="Center" Margin="0,0,15,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverClicked"/>
                    </Label.GestureRecognizers>
                </Label>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="Ciclo Menstrual"
                           FontSize="22" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="Registra tu periodo y síntomas"
                           FontSize="12" TextColor="White" Opacity="0.9"/>
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="25" Padding="25,20,25,40">

                <!-- Tarjeta ciclo actual -->
                <Frame BackgroundColor="{AppThemeBinding Light=#FCF0F4, Dark=#2A1A1F}"
                       CornerRadius="20" HasShadow="False"
                       BorderColor="{AppThemeBinding Light=#FDE3EA, Dark=#4A2A35}"
                       Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Grid.Column="0" Text="📅"
                                   FontSize="20" Margin="0,0,12,0"
                                   VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Tu ciclo actual"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                <Label Text="Día 12 de 28"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                            </VerticalStackLayout>
                        </Grid>
                        <ProgressBar Progress="0.42"
                                     ProgressColor="#F29EBB"
                                     HeightRequest="10"
                                     BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#2C2C2C}"
                                     Margin="0,5"/>
                        <Label Text="Próximo periodo estimado: en 16 días"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Fases del ciclo -->
                <VerticalStackLayout Spacing="15">
                    <Label Text="¿En qué fase estás?"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                           Margin="5,0"/>

                    <Grid ColumnDefinitions="*, *"
                          RowDefinitions="Auto, Auto"
                          ColumnSpacing="15" RowSpacing="15">

                        <Frame x:Name="FaseMenstruacion" Grid.Row="0" Grid.Column="0"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="20" HasShadow="True"
                               BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                               Padding="15">
                            <Frame.Shadow>
                                <Shadow Brush="#A0AF9E" Offset="0,5" Radius="15" Opacity="0.1"/>
                            </Frame.Shadow>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFaseTapped" CommandParameter="FaseMenstruacion"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="🩸" FontSize="20"/>
                                <Label Text="Menstruación"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                <Label Text="Días 1-5" FontSize="11"
                                       TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame x:Name="FaseFolicular" Grid.Row="0" Grid.Column="1"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="20" HasShadow="True"
                               BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                               Padding="15">
                            <Frame.Shadow>
                                <Shadow Brush="#A0AF9E" Offset="0,5" Radius="15" Opacity="0.1"/>
                            </Frame.Shadow>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFaseTapped" CommandParameter="FaseFolicular"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="⚡" FontSize="20"/>
                                <Label Text="Folicular"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                <Label Text="Días 6-13" FontSize="11"
                                       TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame x:Name="FaseOvulacion" Grid.Row="1" Grid.Column="0"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="20" HasShadow="True"
                               BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                               Padding="15">
                            <Frame.Shadow>
                                <Shadow Brush="#A0AF9E" Offset="0,5" Radius="15" Opacity="0.1"/>
                            </Frame.Shadow>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFaseTapped" CommandParameter="FaseOvulacion"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="🙂" FontSize="20"/>
                                <Label Text="Ovulación"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                <Label Text="Días 14-16" FontSize="11"
                                       TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame x:Name="FaseLutea" Grid.Row="1" Grid.Column="1"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="20" HasShadow="True"
                               BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                               Padding="15">
                            <Frame.Shadow>
                                <Shadow Brush="#A0AF9E" Offset="0,5" Radius="15" Opacity="0.1"/>
                            </Frame.Shadow>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFaseTapped" CommandParameter="FaseLutea"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="🌙" FontSize="20"/>
                                <Label Text="Lútea"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                <Label Text="Días 17-28" FontSize="11"
                                       TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                            </VerticalStackLayout>
                        </Frame>

                    </Grid>
                </VerticalStackLayout>

                <!-- Síntomas -->
                <VerticalStackLayout Spacing="15">
                    <Label Text="Síntomas (opcional)"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                           Margin="5,0"/>

                    <Grid ColumnDefinitions="*, *, *"
                          RowDefinitions="Auto, Auto"
                          ColumnSpacing="12" RowSpacing="12">

                        <Frame x:Name="SintomaColicos" Grid.Row="0" Grid.Column="0"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="20" HasShadow="True"
                               BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                               Padding="10,15">
                            <Frame.Shadow>
                                <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.08"/>
                            </Frame.Shadow>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSintomaTapped" CommandParameter="SintomaColicos"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Label Text="🤕" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Cólicos" FontSize="11" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame x:Name="SintomaCabeza" Grid.Row="0" Grid.Column="1"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="20" HasShadow="True"
                               BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                               Padding="10,15">
                            <Frame.Shadow>
                                <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.08"/>
                            </Frame.Shadow>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSintomaTapped" CommandParameter="SintomaCabeza"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Label Text="🤯" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Dolor de cabeza" FontSize="10" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame x:Name="SintomaHinchazón" Grid.Row="0" Grid.Column="2"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="20" HasShadow="True"
                               BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                               Padding="10,15">
                            <Frame.Shadow>
                                <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.08"/>
                            </Frame.Shadow>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSintomaTapped" CommandParameter="SintomaHinchazón"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Label Text="🎈" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Hinchazón" FontSize="10" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame x:Name="SintomaCambiosAnimo" Grid.Row="1" Grid.Column="0"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="20" HasShadow="True"
                               BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                               Padding="10,15">
                            <Frame.Shadow>
                                <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.08"/>
                            </Frame.Shadow>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSintomaTapped" CommandParameter="SintomaCambiosAnimo"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Label Text="🎭" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Cambios ánimo" FontSize="10" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame x:Name="SintomaFatiga" Grid.Row="1" Grid.Column="1"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="20" HasShadow="True"
                               BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                               Padding="10,15">
                            <Frame.Shadow>
                                <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.08"/>
                            </Frame.Shadow>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSintomaTapped" CommandParameter="SintomaFatiga"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Label Text="😴" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Fatiga" FontSize="11" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame x:Name="SintomaAcne" Grid.Row="1" Grid.Column="2"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="20" HasShadow="True"
                               BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                               Padding="10,15">
                            <Frame.Shadow>
                                <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.08"/>
                            </Frame.Shadow>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSintomaTapped" CommandParameter="SintomaAcne"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Label Text="🌋" FontSize="26" HorizontalOptions="Center"/>
                                <Label Text="Acné" FontSize="11" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                    </Grid>
                </VerticalStackLayout>

                <!-- ¿Cómo te sientes hoy? -->
                <VerticalStackLayout Spacing="15">
                    <Label Text="¿Cómo te sientes hoy?"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                           Margin="5,0"/>
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="12">
                            <Frame x:Name="SentimientoTriste"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                   CornerRadius="18" HasShadow="True" Padding="15,10"
                                   BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}">
                                <Frame.Shadow>
                                    <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.1"/>
                                </Frame.Shadow>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSentimientoTapped" CommandParameter="SentimientoTriste"/>
                                </Frame.GestureRecognizers>
                                <Label Text="😢" FontSize="30"/>
                            </Frame>
                            <Frame x:Name="SentimientoPreocupado"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                   CornerRadius="18" HasShadow="True" Padding="15,10"
                                   BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}">
                                <Frame.Shadow>
                                    <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.1"/>
                                </Frame.Shadow>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSentimientoTapped" CommandParameter="SentimientoPreocupado"/>
                                </Frame.GestureRecognizers>
                                <Label Text="😟" FontSize="30"/>
                            </Frame>
                            <Frame x:Name="SentimientoNeutral"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                   CornerRadius="18" HasShadow="True" Padding="15,10"
                                   BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}">
                                <Frame.Shadow>
                                    <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.1"/>
                                </Frame.Shadow>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSentimientoTapped" CommandParameter="SentimientoNeutral"/>
                                </Frame.GestureRecognizers>
                                <Label Text="😐" FontSize="30"/>
                            </Frame>
                            <Frame x:Name="SentimientoBien"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                   CornerRadius="18" HasShadow="True" Padding="15,10"
                                   BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}">
                                <Frame.Shadow>
                                    <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.1"/>
                                </Frame.Shadow>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSentimientoTapped" CommandParameter="SentimientoBien"/>
                                </Frame.GestureRecognizers>
                                <Label Text="🙂" FontSize="30"/>
                            </Frame>
                            <Frame x:Name="SentimientoFeliz"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                   CornerRadius="18" HasShadow="True" Padding="15,10"
                                   BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}">
                                <Frame.Shadow>
                                    <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.1"/>
                                </Frame.Shadow>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSentimientoTapped" CommandParameter="SentimientoFeliz"/>
                                </Frame.GestureRecognizers>
                                <Label Text="😁" FontSize="30"/>
                            </Frame>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Notas personales -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Notas personales"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                           Margin="5,0"/>
                    <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                           CornerRadius="20" HasShadow="True"
                           BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                           Padding="15">
                        <Frame.Shadow>
                            <Shadow Brush="#A0AF9E" Offset="0,6" Radius="15" Opacity="0.1"/>
                        </Frame.Shadow>
                        <Editor Placeholder="Escribe cómo te sientes o cualquier observación..."
                                HeightRequest="80"
                                TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                PlaceholderColor="#94A696"
                                FontSize="14"
                                BackgroundColor="Transparent"/>
                    </Frame>
                </VerticalStackLayout>

                <!-- Botón Guardar -->
                <Button Text="Guardar Registro"
                        BackgroundColor="#F29EBB"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="25"
                        HeightRequest="55"
                        Margin="0,10,0,0">
                    <Button.Shadow>
                        <Shadow Brush="#F29EBB" Offset="0,8" Radius="15" Opacity="0.4"/>
                    </Button.Shadow>
                </Button>

                <!-- Tarjeta ¿Sabías que? -->
                <Frame BackgroundColor="{AppThemeBinding Light=#FCF0F4, Dark=#2A1A1F}"
                       CornerRadius="20" HasShadow="False"
                       BorderColor="{AppThemeBinding Light=#FDE3EA, Dark=#4A2A35}"
                       Padding="20" Margin="0,0,0,20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="💡 ¿Sabías que?"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                        <Label Text="Registrar tu ciclo ayuda a entender mejor tu cuerpo y predecir cambios en tu energía vital. ¡Tu planta también se beneficia de estos datos!"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                               LineHeight="1.3"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BARRA NAVEGACIÓN -->
        <Frame Grid.Row="2"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
               CornerRadius="0" Padding="15,10" HasShadow="False"
               BorderColor="{AppThemeBinding Light=#EEF2EE, Dark=#3C3C3C}"
               VerticalOptions="End">
            <Grid ColumnDefinitions="*, *, *"
                  MaximumWidthRequest="800" HorizontalOptions="FillAndExpand">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInicioTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="🏠" FontSize="22" HorizontalOptions="Center"/>
                    <Label Text="Inicio" FontSize="11" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRetosTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="🏆" FontSize="22" HorizontalOptions="Center"/>
                    <Label Text="Retos" FontSize="11" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPerfilTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="👤" FontSize="22" HorizontalOptions="Center"/>
                    <Label Text="Perfil" FontSize="11" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                </VerticalStackLayout>
            </Grid>
        </Frame>

    </Grid>
</ContentPage>