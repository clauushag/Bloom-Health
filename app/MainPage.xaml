<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app.MainPage"
             BackgroundColor="{AppThemeBinding Light=#F7F9F7, Dark=#121212}"
             Shell.NavBarIsVisible="False">

       <Grid>
              <ScrollView>
                     <VerticalStackLayout Spacing="30"
                                          Padding="30,60,30,40"
                                          MaximumWidthRequest="700"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Start">

                            <VerticalStackLayout Spacing="8">
                                   <Label Text="BLOOM HEALTH"
                                          FontSize="28"
                                          CharacterSpacing="4"
                                          TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                          FontAttributes="Bold"
                                          HorizontalOptions="Center"
                                          FontFamily="OpenSansSemibold"/>
                                   <Label Text="{Binding UsuarioActual.Nombre, StringFormat='Bienvenido {0}, ¿qué tal estás?'}"
                                          FontSize="12"
                                          CharacterSpacing="2"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                          FontAttributes="Bold"
                                          HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                   CornerRadius="40"
                                   HasShadow="False"
                                   BorderColor="{AppThemeBinding Light=#EEF2EE, Dark=#3C3C3C}"
                                   Padding="30,45">
                                   <Frame.Shadow>
                                          <Shadow Brush="#A0AF9E"
                                                  Offset="0,20"
                                                  Radius="40"
                                                  Opacity="0.12"/>
                                   </Frame.Shadow>

                                   <VerticalStackLayout Spacing="30">
                                          <Border StrokeShape="RoundRectangle 20"
                                                  StrokeThickness="0"
                                                  HeightRequest="200"
                                                  WidthRequest="200">
                                                 <Image x:Name="PlantaImage"
                                                        Source="{Binding ImagenPlanta}"
                                                        Aspect="AspectFill"/>
                                          </Border>

                                          <VerticalStackLayout Spacing="10">
                                                 <Label Text="ESTADO ACTUAL"
                                                        FontSize="11"
                                                        CharacterSpacing="2"
                                                        TextColor="{AppThemeBinding Light=#B0BDB2, Dark=#1E1E1E}"
                                                        FontAttributes="Bold"
                                                        HorizontalOptions="Center"/>
                                                 <Label Text="{Binding AvatarActual.Estado_Salud, StringFormat='Tu planta está {0}'}"
                                                        FontSize="18"
                                                        TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                                        FontAttributes="Bold"
                                                        HorizontalTextAlignment="Center"/>
                                          </VerticalStackLayout>

                                          <VerticalStackLayout Spacing="12">
                                                 <Grid ColumnDefinitions="*, Auto">
                                                        <Label Text="ENERGÍA VITAL"
                                                               FontSize="10"
                                                               TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                                               FontAttributes="Bold"
                                                               CharacterSpacing="1"/>
                                                        <Label Grid.Column="1"
                                                               Text="{Binding AvatarActual.XP, StringFormat='{0}%'}"
                                                               FontSize="11"
                                                               TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                                               FontAttributes="Bold"/>
                                                 </Grid>
                                                 <Border BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#2C2C2C}"
                                                         HeightRequest="14"
                                                         StrokeShape="RoundRectangle 7"
                                                         StrokeThickness="0">
                                                        <ProgressBar Progress="{Binding ProgresoXP}"
                                                                     ProgressColor="#8EB497"
                                                                     VerticalOptions="Center"
                                                                     ScaleY="3"/>
                                                 </Border>
                                          </VerticalStackLayout>
                                   </VerticalStackLayout>
                            </Frame>

                            <Frame BackgroundColor="{AppThemeBinding Light=#F1F5F1, Dark=#1E1E1E}"
                                   Padding="20"
                                   CornerRadius="25"
                                   HasShadow="False"
                                   BorderColor="{AppThemeBinding Light=#E2EAE2, Dark=#3C3C3C}">
                                   <HorizontalStackLayout Spacing="15">
                                          <Label Text="💡"
                                                 VerticalOptions="Center"
                                                 FontSize="22"/>
                                          <VerticalStackLayout VerticalOptions="Center"
                                                               Spacing="2">
                                                 <Label Text="TIP DEL DÍA"
                                                        FontSize="10"
                                                        TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                                        FontAttributes="Bold"
                                                        CharacterSpacing="1"/>
                                                 <Label Text="Beber agua regularmente ayuda a tu planta."
                                                        TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                                        FontSize="14"
                                                        FontAttributes="Bold"/>
                                          </VerticalStackLayout>
                                   </HorizontalStackLayout>
                            </Frame>

                            <VerticalStackLayout Spacing="15">
                                   <Label Text="EVOLUCIÓN DEL AVATAR"
                                          FontSize="11"
                                          CharacterSpacing="2"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                          FontAttributes="Bold"
                                          Margin="10,0"/>

                                   <ScrollView Orientation="Horizontal"
                                               HorizontalScrollBarVisibility="Never">
                                          <HorizontalStackLayout Spacing="18"
                                                                 Padding="5,5,40,30">

                                                 <Frame WidthRequest="160"
                                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                                        CornerRadius="25"
                                                        HasShadow="False"
                                                        BorderColor="{AppThemeBinding Light=#EEF2EE, Dark=#3C3C3C}"
                                                        Padding="15">
                                                        <Frame.Shadow>
                                                               <Shadow Brush="#A0AF9E"
                                                                       Offset="0,8"
                                                                       Radius="15"
                                                                       Opacity="0.1"/>
                                                        </Frame.Shadow>
                                                        <VerticalStackLayout Spacing="10"
                                                                             HorizontalOptions="Center">
                                                               <Image Source="plantafuerte.png"
                                                                      HeightRequest="70"
                                                                      Opacity="0.4"/>
                                                               <Label Text="MARCHITA"
                                                                      FontSize="11"
                                                                      FontAttributes="Bold"
                                                                      TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                                                      HorizontalOptions="Center"/>
                                                               <Label Text="0-25%"
                                                                      FontSize="10"
                                                                      TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                                                      HorizontalOptions="Center"/>
                                                        </VerticalStackLayout>
                                                 </Frame>

                                                 <Frame WidthRequest="160"
                                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                                        CornerRadius="25"
                                                        HasShadow="False"
                                                        BorderColor="{AppThemeBinding Light=#EEF2EE, Dark=#3C3C3C}"
                                                        Padding="15">
                                                        <Frame.Shadow>
                                                               <Shadow Brush="#A0AF9E"
                                                                       Offset="0,8"
                                                                       Radius="15"
                                                                       Opacity="0.1"/>
                                                        </Frame.Shadow>
                                                        <VerticalStackLayout Spacing="10"
                                                                             HorizontalOptions="Center">
                                                               <Image Source="plantafuerte.png"
                                                                      HeightRequest="70"
                                                                      Opacity="0.6"/>
                                                               <Label Text="CRECIENDO"
                                                                      FontSize="11"
                                                                      FontAttributes="Bold"
                                                                      TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                                                      HorizontalOptions="Center"/>
                                                               <Label Text="26-50%"
                                                                      FontSize="10"
                                                                      TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                                                      HorizontalOptions="Center"/>
                                                        </VerticalStackLayout>
                                                 </Frame>

                                                 <Frame WidthRequest="160"
                                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                                        CornerRadius="25"
                                                        HasShadow="False"
                                                        BorderColor="{AppThemeBinding Light=#EEF2EE, Dark=#3C3C3C}"
                                                        Padding="15">
                                                        <Frame.Shadow>
                                                               <Shadow Brush="#A0AF9E"
                                                                       Offset="0,8"
                                                                       Radius="15"
                                                                       Opacity="0.1"/>
                                                        </Frame.Shadow>
                                                        <VerticalStackLayout Spacing="10"
                                                                             HorizontalOptions="Center">
                                                               <Image Source="plantafuerte.png"
                                                                      HeightRequest="70"
                                                                      Opacity="0.8"/>
                                                               <Label Text="FLORECIENDO"
                                                                      FontSize="11"
                                                                      FontAttributes="Bold"
                                                                      TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                                                      HorizontalOptions="Center"/>
                                                               <Label Text="51-75%"
                                                                      FontSize="10"
                                                                      TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                                                      HorizontalOptions="Center"/>
                                                        </VerticalStackLayout>
                                                 </Frame>

                                                 <Frame WidthRequest="160"
                                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                                        CornerRadius="25"
                                                        HasShadow="False"
                                                        BorderColor="{AppThemeBinding Light=#EEF2EE, Dark=#3C3C3C}"
                                                        Padding="15">
                                                        <Frame.Shadow>
                                                               <Shadow Brush="#A0AF9E"
                                                                       Offset="0,8"
                                                                       Radius="15"
                                                                       Opacity="0.1"/>
                                                        </Frame.Shadow>
                                                        <VerticalStackLayout Spacing="10"
                                                                             HorizontalOptions="Center">
                                                               <Image Source="plantafuerte.png"
                                                                      HeightRequest="70"/>
                                                               <Label Text="FUERTE"
                                                                      FontSize="11"
                                                                      FontAttributes="Bold"
                                                                      TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                                                      HorizontalOptions="Center"/>
                                                               <Label Text="76-100%"
                                                                      FontSize="10"
                                                                      TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                                                      HorizontalOptions="Center"/>
                                                        </VerticalStackLayout>
                                                 </Frame>

                                          </HorizontalStackLayout>
                                   </ScrollView>
                            </VerticalStackLayout>

                     </VerticalStackLayout>
              </ScrollView>

              <!-- Fondo oscuro semitransparente (tap para cerrar) -->
              <BoxView x:Name="MenuOverlay"
                       BackgroundColor="#80000000"
                       IsVisible="False"
                       Grid.RowSpan="2">
                     <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCerrarMenuTapped"/>
                     </BoxView.GestureRecognizers>
              </BoxView>

              <!-- Botón + -->
              <Button Text="+"
                      BackgroundColor="{AppThemeBinding Light=#8EB497, Dark=#1E1E1E}"
                      TextColor="#F7F9F7"
                      FontSize="32"
                      CornerRadius="35"
                      HeightRequest="70"
                      WidthRequest="70"
                      HorizontalOptions="End"
                      VerticalOptions="End"
                      Margin="40,0,40,110"
                      Clicked="OnAddClicked">
                     <Button.Shadow>
                            <Shadow Brush="#8EB497"
                                    Offset="0,10"
                                    Radius="20"
                                    Opacity="0.4"/>
                     </Button.Shadow>
              </Button>

              <!-- Panel del menú (oculto por defecto) -->
              <Frame x:Name="MenuPanel"
                     BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                     CornerRadius="40"
                     Padding="30,40"
                     Margin="0"
                     HasShadow="True"
                     BorderColor="Transparent"
                     VerticalOptions="End"
                     IsVisible="False">
                     <VerticalStackLayout Spacing="18">

                            <Grid ColumnDefinitions="*, Auto"
                                  Margin="0,0,0,5">
                                   <Label Text="AÑADIR REGISTRO"
                                          FontSize="18"
                                          FontAttributes="Bold"
                                          TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                          CharacterSpacing="1"/>
                                   <Button Grid.Column="1"
                                           Text="✕"
                                           TextColor="#7A8B7C"
                                           BackgroundColor="Transparent"
                                           Clicked="OnCerrarMenuTapped"
                                           FontSize="20"/>
                            </Grid>

                            <Frame BackgroundColor="#8EBC8F"
                                   Padding="18"
                                   CornerRadius="20"
                                   HasShadow="False"
                                   BorderColor="Transparent">
                                   <Frame.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnActividadTapped"/>
                                   </Frame.GestureRecognizers>
                                   <HorizontalStackLayout Spacing="20">
                                          <Label Text="🏃"
                                                 FontSize="24"
                                                 VerticalOptions="Center"/>
                                          <Label Text="ACTIVIDAD"
                                                 TextColor="White"
                                                 FontAttributes="Bold"
                                                 VerticalOptions="Center"
                                                 FontSize="15"
                                                 CharacterSpacing="1.5"/>
                                   </HorizontalStackLayout>
                            </Frame>

                            <Frame BackgroundColor="#D9A673"
                                   Padding="18"
                                   CornerRadius="20"
                                   HasShadow="False"
                                   BorderColor="Transparent">
                                   <Frame.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnComidaTapped"/>
                                   </Frame.GestureRecognizers>
                                   <HorizontalStackLayout Spacing="20">
                                          <Label Text="🍎"
                                                 FontSize="24"
                                                 VerticalOptions="Center"/>
                                          <Label Text="COMIDA"
                                                 TextColor="White"
                                                 FontAttributes="Bold"
                                                 VerticalOptions="Center"
                                                 FontSize="15"
                                                 CharacterSpacing="1.5"/>
                                   </HorizontalStackLayout>
                            </Frame>

                            <Frame BackgroundColor="#5E8D5E"
                                   Padding="18"
                                   CornerRadius="20"
                                   HasShadow="False"
                                   BorderColor="Transparent">
                                   <Frame.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnEstadoTapped"/>
                                   </Frame.GestureRecognizers>
                                   <HorizontalStackLayout Spacing="20">
                                          <Label Text="🧠"
                                                 FontSize="24"
                                                 VerticalOptions="Center"/>
                                          <Label Text="ESTADO ANÍMICO"
                                                 TextColor="White"
                                                 FontAttributes="Bold"
                                                 VerticalOptions="Center"
                                                 FontSize="15"
                                                 CharacterSpacing="1.5"/>
                                   </HorizontalStackLayout>
                            </Frame>

                            <Frame BackgroundColor="#F2A7B5"
                                   Padding="18"
                                   CornerRadius="20"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   Margin="0,0,0,10">
                                   <Frame.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnMenstrualTapped"/>
                                   </Frame.GestureRecognizers>
                                   <HorizontalStackLayout Spacing="20">
                                          <Label Text="📅"
                                                 FontSize="24"
                                                 VerticalOptions="Center"/>
                                          <Label Text="SALUD MENSTRUAL"
                                                 TextColor="White"
                                                 FontAttributes="Bold"
                                                 VerticalOptions="Center"
                                                 FontSize="15"
                                                 CharacterSpacing="1.5"/>
                                   </HorizontalStackLayout>
                            </Frame>

                     </VerticalStackLayout>
              </Frame>


              <Frame Grid.Row="1"
                     BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                     CornerRadius="0"
                     Padding="10,6"
                     HasShadow="False"
                     BorderColor="{AppThemeBinding Light=#EEF2EE, Dark=#3C3C3C}"
                     VerticalOptions="End">

                     <Grid ColumnDefinitions="*, *, *"
                           MaximumWidthRequest="800"
                           HorizontalOptions="FillAndExpand">

                            <!-- Inicio -->
                            <VerticalStackLayout Grid.Column="0"
                                                 HorizontalOptions="Center"
                                                 Spacing="2">
                                   <VerticalStackLayout.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnInicioTapped"/>
                                   </VerticalStackLayout.GestureRecognizers>
                                   <Label Text="🏠"
                                          FontSize="20"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                   <Label Text="Inicio"
                                          FontSize="11"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                          FontAttributes="Bold"/>
                            </VerticalStackLayout>

                            <!-- Retos -->
                            <VerticalStackLayout Grid.Column="1"
                                                 HorizontalOptions="Center"
                                                 Spacing="2">
                                   <VerticalStackLayout.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnRetosTapped"/>
                                   </VerticalStackLayout.GestureRecognizers>
                                   <Label Text="🏆"
                                          FontSize="20"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                   <Label Text="Retos"
                                          FontSize="11"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                            </VerticalStackLayout>

                            <!-- Perfil -->
                            <VerticalStackLayout Grid.Column="2"
                                                 HorizontalOptions="Center"
                                                 Spacing="2">
                                   <VerticalStackLayout.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnPerfilTapped"/>
                                   </VerticalStackLayout.GestureRecognizers>
                                   <Label Text="👤"
                                          FontSize="20"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                   <Label Text="Perfil"
                                          FontSize="11"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                            </VerticalStackLayout>

                     </Grid>
              </Frame>
       </Grid>
</ContentPage>