<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app.NutricionPage"
             BackgroundColor="#F7F9F7"
             Shell.NavBarIsVisible="False">

       <Grid>
              <ScrollView>
                     <VerticalStackLayout Spacing="20"
                                          Padding="25,50,25,40">

                            <Grid ColumnDefinitions="Auto, *"
                                  ColumnSpacing="15"
                                  Margin="0,0,0,10">
                                   <Label Grid.Column="0"
                                          Text="←"
                                          FontSize="26"
                                          TextColor="#2D3A2F"
                                          VerticalOptions="Center">
                                          <Label.GestureRecognizers>
                                                 <TapGestureRecognizer/>
                                          </Label.GestureRecognizers>
                                   </Label>

                                   <VerticalStackLayout Grid.Column="1"
                                                        VerticalOptions="Center">
                                          <Label Text="Registro Nutricional"
                                                 FontSize="20"
                                                 FontAttributes="Bold"
                                                 TextColor="#2D3A2F"/>
                                          <Label Text="Añade lo que comiste hoy"
                                                 FontSize="12"
                                                 TextColor="#7A8B7C"/>
                                   </VerticalStackLayout>
                            </Grid>

                            <Frame BackgroundColor="#8EB497"
                                   CornerRadius="25"
                                   HasShadow="True"
                                   BorderColor="Transparent"
                                   Padding="20,40">
                                   <Frame.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnAbrirScannerTapped"/>
                                   </Frame.GestureRecognizers>
                                   <Frame.Shadow>
                                          <Shadow Brush="#8EB497"
                                                  Offset="0,12"
                                                  Radius="20"
                                                  Opacity="0.4"/>
                                   </Frame.Shadow>

                                   <VerticalStackLayout Spacing="10"
                                                        HorizontalOptions="Center">
                                          <Label Text="📷"
                                                 FontSize="40"
                                                 HorizontalOptions="Center"
                                                 TextColor="White"
                                                 Margin="0,0,0,5"/>
                                          <Label Text="Escanear Código de Barras"
                                                 FontSize="18"
                                                 FontAttributes="Bold"
                                                 TextColor="White"
                                                 HorizontalOptions="Center"/>
                                          <Label Text="Modo rápido de registro"
                                                 FontSize="12"
                                                 TextColor="#D1E2D4"
                                                 HorizontalOptions="Center"/>
                                   </VerticalStackLayout>
                            </Frame>

                            <Grid ColumnDefinitions="*, Auto, *"
                                  ColumnSpacing="15"
                                  VerticalOptions="Center"
                                  Margin="0,5">
                                   <BoxView Grid.Column="0"
                                            HeightRequest="1"
                                            Color="#D1E2D4"
                                            VerticalOptions="Center"/>
                                   <Label Grid.Column="1"
                                          Text="o busca manualmente"
                                          FontSize="11"
                                          TextColor="#A0AF9E"
                                          VerticalOptions="Center"/>
                                   <BoxView Grid.Column="2"
                                            HeightRequest="1"
                                            Color="#D1E2D4"
                                            VerticalOptions="Center"/>
                            </Grid>

                            <VerticalStackLayout Spacing="8">
                                   <Label Text="Buscar alimento"
                                          FontSize="12"
                                          TextColor="#7A8B7C"
                                          FontAttributes="Bold"
                                          Margin="5,0"/>
                                   <Frame BackgroundColor="White"
                                          CornerRadius="25"
                                          HasShadow="True"
                                          BorderColor="Transparent"
                                          Padding="15,2">
                                          <Frame.Shadow>
                                                 <Shadow Brush="#A0AF9E"
                                                         Offset="0,8"
                                                         Radius="15"
                                                         Opacity="0.1"/>
                                          </Frame.Shadow>
                                          <Grid ColumnDefinitions="Auto, *">
                                                 <Label Grid.Column="0"
                                                        Text="🔍"
                                                        VerticalOptions="Center"
                                                        Margin="5,0,10,0"
                                                        TextColor="#94A696"
                                                        FontSize="16"/>
                                                 <Entry Grid.Column="1"
                                                        Placeholder="Ej: manzana, arroz, pollo..."
                                                        PlaceholderColor="#94A696"
                                                        TextColor="#2D3A2F"
                                                        FontSize="14"
                                                        VerticalOptions="Center"/>
                                          </Grid>
                                   </Frame>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="10">
                                   <Label Text="Sugerencias rápidas"
                                          FontSize="12"
                                          TextColor="#7A8B7C"
                                          FontAttributes="Bold"
                                          Margin="5,0"/>

                                   <HorizontalStackLayout Spacing="10">
                                          <Frame BackgroundColor="#E8F2E9"
                                                 CornerRadius="20"
                                                 HasShadow="False"
                                                 BorderColor="Transparent"
                                                 Padding="15,8">
                                                 <Label Text="🍎 Frutas"
                                                        FontSize="12"
                                                        TextColor="#2D3A2F"
                                                        FontAttributes="Bold"/>
                                          </Frame>

                                          <Frame BackgroundColor="#E8F2E9"
                                                 CornerRadius="20"
                                                 HasShadow="False"
                                                 BorderColor="Transparent"
                                                 Padding="15,8">
                                                 <Label Text="🥗 Ensalada"
                                                        FontSize="12"
                                                        TextColor="#2D3A2F"
                                                        FontAttributes="Bold"/>
                                          </Frame>

                                          <Frame BackgroundColor="#E8F2E9"
                                                 CornerRadius="20"
                                                 HasShadow="False"
                                                 BorderColor="Transparent"
                                                 Padding="15,8">
                                                 <Label Text="🍗 Proteína"
                                                        FontSize="12"
                                                        TextColor="#2D3A2F"
                                                        FontAttributes="Bold"/>
                                          </Frame>
                                   </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="12"
                                                 Margin="0,10,0,0">
                                   <Label Text="Alimentos recientes"
                                          FontSize="12"
                                          TextColor="#7A8B7C"
                                          FontAttributes="Bold"
                                          Margin="5,0"/>

                                   <Frame BackgroundColor="White"
                                          CornerRadius="20"
                                          HasShadow="True"
                                          BorderColor="Transparent"
                                          Padding="20,15">
                                          <Frame.Shadow>
                                                 <Shadow Brush="#A0AF9E"
                                                         Offset="0,6"
                                                         Radius="15"
                                                         Opacity="0.1"/>
                                          </Frame.Shadow>
                                          <Grid ColumnDefinitions="*, Auto">
                                                 <VerticalStackLayout Grid.Column="0"
                                                                      Spacing="2">
                                                        <Label Text="Ensalada verde"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"/>
                                                        <Label Text="Hace 2 horas"
                                                               FontSize="11"
                                                               TextColor="#7A8B7C"/>
                                                 </VerticalStackLayout>
                                                 <Label Grid.Column="1"
                                                        Text="120 kcal"
                                                        FontSize="12"
                                                        TextColor="#7A8B7C"
                                                        VerticalOptions="Center"/>
                                          </Grid>
                                   </Frame>

                                   <Frame BackgroundColor="White"
                                          CornerRadius="20"
                                          HasShadow="True"
                                          BorderColor="Transparent"
                                          Padding="20,15">
                                          <Frame.Shadow>
                                                 <Shadow Brush="#A0AF9E"
                                                         Offset="0,6"
                                                         Radius="15"
                                                         Opacity="0.1"/>
                                          </Frame.Shadow>
                                          <Grid ColumnDefinitions="*, Auto">
                                                 <VerticalStackLayout Grid.Column="0"
                                                                      Spacing="2">
                                                        <Label Text="Pechuga de pollo"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"/>
                                                        <Label Text="Ayer"
                                                               FontSize="11"
                                                               TextColor="#7A8B7C"/>
                                                 </VerticalStackLayout>
                                                 <Label Grid.Column="1"
                                                        Text="250 kcal"
                                                        FontSize="12"
                                                        TextColor="#7A8B7C"
                                                        VerticalOptions="Center"/>
                                          </Grid>
                                   </Frame>
                            </VerticalStackLayout>

                     </VerticalStackLayout>
              </ScrollView>

              <Frame Grid.Row="1"
                     BackgroundColor="White"
                     CornerRadius="0"
                     Padding="15,10"
                     HasShadow="False"
                     BorderColor="#EEF2EE"
                     VerticalOptions="End">

                     <Grid ColumnDefinitions="*, *, *"
                           MaximumWidthRequest="800"
                           HorizontalOptions="FillAndExpand">

                            <!-- Inicio -->
                            <VerticalStackLayout Grid.Column="0"
                                                 HorizontalOptions="Center"
                                                 Spacing="2">
                                   <VerticalStackLayout.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnInicioTapped"/>
                                   </VerticalStackLayout.GestureRecognizers>
                                   <Label Text="🏠"
                                          FontSize="22"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                   <Label Text="Inicio"
                                          FontSize="11"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                          FontAttributes="Bold"/>
                            </VerticalStackLayout>

                            <!-- Retos -->
                            <VerticalStackLayout Grid.Column="1"
                                                 HorizontalOptions="Center"
                                                 Spacing="2">
                                   <VerticalStackLayout.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnRetosTapped"/>
                                   </VerticalStackLayout.GestureRecognizers>
                                   <Label Text="🏆"
                                          FontSize="22"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                   <Label Text="Retos"
                                          FontSize="11"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                            </VerticalStackLayout>

                            <!-- Perfil -->
                            <VerticalStackLayout Grid.Column="2"
                                                 HorizontalOptions="Center"
                                                 Spacing="2">
                                   <VerticalStackLayout.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnPerfilTapped"/>
                                   </VerticalStackLayout.GestureRecognizers>
                                   <Label Text="👤"
                                          FontSize="22"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                   <Label Text="Perfil"
                                          FontSize="11"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                            </VerticalStackLayout>

                     </Grid>
              </Frame>
       </Grid>
</ContentPage>