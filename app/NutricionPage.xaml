<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app.NutricionPage"
             BackgroundColor="#F7F9F7"
             Shell.NavBarIsVisible="False">

       <Grid>
              <ScrollView>
                     <VerticalStackLayout Spacing="20"
                                          Padding="25,50,25,40">

                            <Grid ColumnDefinitions="Auto, *"
                                  ColumnSpacing="15"
                                  Margin="0,0,0,10">
                                   <Label Grid.Column="0"
                                          Text="←"
                                          FontSize="26"
                                          TextColor="#2D3A2F"
                                          VerticalOptions="Center">
                                          <Label.GestureRecognizers>
                                                 <TapGestureRecognizer/>
                                          </Label.GestureRecognizers>
                                   </Label>

                                   <VerticalStackLayout Grid.Column="1"
                                                        VerticalOptions="Center">
                                          <Label Text="Registro Nutricional"
                                                 FontSize="20"
                                                 FontAttributes="Bold"
                                                 TextColor="#2D3A2F"/>
                                          <Label Text="Añade lo que comiste hoy"
                                                 FontSize="12"
                                                 TextColor="#7A8B7C"/>
                                   </VerticalStackLayout>
                            </Grid>


                            <!-- Resumen kcal de hoy -->
                            <Frame BackgroundColor="#E8F2E9"
                                   CornerRadius="20"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   Padding="15,10">
                                   <Label x:Name="KcalHoyLabel"
                                          Text="0 kcal ingeridas hoy"
                                          FontSize="13"
                                          FontAttributes="Bold"
                                          TextColor="#2D3A2F"
                                          HorizontalOptions="Center"/>
                            </Frame>

                            <!-- Tarjeta de Resultado Nutricional -->
                            <Frame x:Name="ResultadoCard"
                                   IsVisible="False"
                                   BackgroundColor="White"
                                   CornerRadius="25"
                                   HasShadow="True"
                                   BorderColor="Transparent"
                                   Padding="20,20"
                                   Margin="0,0,0,10">
                                   <Frame.Shadow>
                                          <Shadow Brush="#A0AF9E"
                                                  Offset="0,8"
                                                  Radius="15"
                                                  Opacity="0.2"/>
                                   </Frame.Shadow>

                                   <VerticalStackLayout Spacing="15">
                                          <!-- Header con Imagen, Título y botón cerrar -->
                                          <Grid ColumnDefinitions="Auto,*,Auto"
                                                ColumnSpacing="15">
                                                 <Frame Grid.Column="0"
                                                        CornerRadius="15"
                                                        Padding="0"
                                                        IsClippedToBounds="True"
                                                        HeightRequest="60"
                                                        WidthRequest="60"
                                                        BackgroundColor="#E8F2E9">
                                                        <Image x:Name="FoodImage"
                                                               Aspect="AspectFill"/>
                                                 </Frame>
                                                 <VerticalStackLayout Grid.Column="1"
                                                                      VerticalOptions="Center"
                                                                      Spacing="2">
                                                        <Label x:Name="FoodNameLabel"
                                                               FontSize="16"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"
                                                               MaxLines="2"
                                                               LineBreakMode="TailTruncation"/>
                                                        <Label x:Name="FoodBrandLabel"
                                                               FontSize="12"
                                                               TextColor="#7A8B7C"/>
                                                 </VerticalStackLayout>
                                                 <ImageButton Grid.Column="2"
                                                              Source="{FontImage FontFamily=SegoeUI, Glyph='❌', Size=16, Color=#A0AF9E}"
                                                              VerticalOptions="Start"
                                                              HorizontalOptions="End"
                                                              HeightRequest="30"
                                                              WidthRequest="30"
                                                              BackgroundColor="Transparent"
                                                              Clicked="OnCloseCardClicked"/>
                                          </Grid>

                                          <BoxView HeightRequest="1"
                                                   Color="#EEF2EE"
                                                   Margin="0,5"/>

                                          <!-- Cuadrícula Nutricional -->
                                          <Grid RowDefinitions="Auto,Auto"
                                                ColumnDefinitions="*,*,*"
                                                RowSpacing="15"
                                                ColumnSpacing="10">
                                                 <!-- Kcal -->
                                                 <VerticalStackLayout Grid.Row="0"
                                                                      Grid.Column="0"
                                                                      HorizontalOptions="Center"
                                                                      Spacing="2">
                                                        <Label Text="🔥 Kcal"
                                                               FontSize="12"
                                                               TextColor="#7A8B7C"
                                                               HorizontalOptions="Center"/>
                                                        <Label x:Name="KcalLabel"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"
                                                               HorizontalOptions="Center"/>
                                                 </VerticalStackLayout>
                                                 <!-- Proteinas -->
                                                 <VerticalStackLayout Grid.Row="0"
                                                                      Grid.Column="1"
                                                                      HorizontalOptions="Center"
                                                                      Spacing="2">
                                                        <Label Text="🥩 Prot"
                                                               FontSize="12"
                                                               TextColor="#7A8B7C"
                                                               HorizontalOptions="Center"/>
                                                        <Label x:Name="ProteinasLabel"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"
                                                               HorizontalOptions="Center"/>
                                                 </VerticalStackLayout>
                                                 <!-- Carbos -->
                                                 <VerticalStackLayout Grid.Row="0"
                                                                      Grid.Column="2"
                                                                      HorizontalOptions="Center"
                                                                      Spacing="2">
                                                        <Label Text="🌾 Carb"
                                                               FontSize="12"
                                                               TextColor="#7A8B7C"
                                                               HorizontalOptions="Center"/>
                                                        <Label x:Name="CarbosLabel"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"
                                                               HorizontalOptions="Center"/>
                                                 </VerticalStackLayout>

                                                 <!-- Grasas -->
                                                 <VerticalStackLayout Grid.Row="1"
                                                                      Grid.Column="0"
                                                                      HorizontalOptions="Center"
                                                                      Spacing="2">
                                                        <Label Text="🥑 Grasas"
                                                               FontSize="12"
                                                               TextColor="#7A8B7C"
                                                               HorizontalOptions="Center"/>
                                                        <Label x:Name="GrasasLabel"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"
                                                               HorizontalOptions="Center"/>
                                                 </VerticalStackLayout>
                                                 <!-- Fibra -->
                                                 <VerticalStackLayout Grid.Row="1"
                                                                      Grid.Column="1"
                                                                      HorizontalOptions="Center"
                                                                      Spacing="2">
                                                        <Label Text="🥦 Fibra"
                                                               FontSize="12"
                                                               TextColor="#7A8B7C"
                                                               HorizontalOptions="Center"/>
                                                        <Label x:Name="FibraLabel"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"
                                                               HorizontalOptions="Center"/>
                                                 </VerticalStackLayout>
                                          </Grid>

                                          <!-- Acción -->
                                          <Button Text="Añadir a mi registro"
                                                  BackgroundColor="#8EB497"
                                                  TextColor="White"
                                                  CornerRadius="20"
                                                  Margin="0,10,0,0"
                                                  FontAttributes="Bold"
                                                  Clicked="OnAddFoodClicked"/>
                                   </VerticalStackLayout>
                            </Frame>
                            <Grid>
                                   <Frame BackgroundColor="#8EB497"
                                          CornerRadius="25"
                                          HasShadow="True"
                                          BorderColor="Transparent"
                                          Padding="20,40">
                                          <!-- <Frame.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnAbrirScannerTapped"/>
                                   </Frame.GestureRecognizers> -->
                                          <Frame.Shadow>
                                                 <Shadow Brush="#8EB497"
                                                         Offset="0,12"
                                                         Radius="20"
                                                         Opacity="0.4"/>
                                          </Frame.Shadow>

                                          <VerticalStackLayout Spacing="10"
                                                               HorizontalOptions="Center">
                                                 <Label Text="📷"
                                                        FontSize="40"
                                                        HorizontalOptions="Center"
                                                        TextColor="White"
                                                        Margin="0,0,0,5"/>
                                                 <Label Text="Escanear Código de Barras"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        TextColor="White"
                                                        HorizontalOptions="Center"/>
                                                 <Label Text="Modo rápido de registro"
                                                        FontSize="12"
                                                        TextColor="#D1E2D4"
                                                        HorizontalOptions="Center"/>
                                          </VerticalStackLayout>
                                   </Frame>
                                   <Button Text=""
                                           BackgroundColor="Transparent"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill"
                                           Clicked="OnAbrirScannerClicked"/>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto, *"
                                  ColumnSpacing="15"
                                  VerticalOptions="Center"
                                  Margin="0,5">
                                   <BoxView Grid.Column="0"
                                            HeightRequest="1"
                                            Color="#D1E2D4"
                                            VerticalOptions="Center"/>
                                   <Label Grid.Column="1"
                                          Text="o busca manualmente"
                                          FontSize="11"
                                          TextColor="#A0AF9E"
                                          VerticalOptions="Center"/>
                                   <BoxView Grid.Column="2"
                                            HeightRequest="1"
                                            Color="#D1E2D4"
                                            VerticalOptions="Center"/>
                            </Grid>

                            <VerticalStackLayout Spacing="8">
                                   <Label Text="Buscar alimento"
                                          FontSize="12"
                                          TextColor="#7A8B7C"
                                          FontAttributes="Bold"
                                          Margin="5,0"/>
                                   <Frame BackgroundColor="White"
                                          CornerRadius="25"
                                          HasShadow="True"
                                          BorderColor="Transparent"
                                          Padding="15,2">
                                          <Frame.Shadow>
                                                 <Shadow Brush="#A0AF9E"
                                                         Offset="0,8"
                                                         Radius="15"
                                                         Opacity="0.1"/>
                                          </Frame.Shadow>
                                          <Grid ColumnDefinitions="Auto, *">
                                                 <Label Grid.Column="0"
                                                        Text="🔍"
                                                        VerticalOptions="Center"
                                                        Margin="5,0,10,0"
                                                        TextColor="#94A696"
                                                        FontSize="16"/>
                                                 <Entry Grid.Column="1"
                                                        Placeholder="Ej: manzana, arroz, pollo..."
                                                        PlaceholderColor="#94A696"
                                                        TextColor="#2D3A2F"
                                                        FontSize="14"
                                                        VerticalOptions="Center"/>
                                          </Grid>
                                   </Frame>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="10">
                                   <Label Text="Sugerencias rápidas"
                                          FontSize="12"
                                          TextColor="#7A8B7C"
                                          FontAttributes="Bold"
                                          Margin="5,0"/>

                                   <HorizontalStackLayout Spacing="10">
                                          <Frame BackgroundColor="#E8F2E9"
                                                 CornerRadius="20"
                                                 HasShadow="False"
                                                 BorderColor="Transparent"
                                                 Padding="15,8">
                                                 <Label Text="🍎 Frutas"
                                                        FontSize="12"
                                                        TextColor="#2D3A2F"
                                                        FontAttributes="Bold"/>
                                          </Frame>

                                          <Frame BackgroundColor="#E8F2E9"
                                                 CornerRadius="20"
                                                 HasShadow="False"
                                                 BorderColor="Transparent"
                                                 Padding="15,8">
                                                 <Label Text="🥗 Ensalada"
                                                        FontSize="12"
                                                        TextColor="#2D3A2F"
                                                        FontAttributes="Bold"/>
                                          </Frame>

                                          <Frame BackgroundColor="#E8F2E9"
                                                 CornerRadius="20"
                                                 HasShadow="False"
                                                 BorderColor="Transparent"
                                                 Padding="15,8">
                                                 <Label Text="🍗 Proteína"
                                                        FontSize="12"
                                                        TextColor="#2D3A2F"
                                                        FontAttributes="Bold"/>
                                          </Frame>
                                   </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="12"
                                          Margin="0,10,0,0">
                                   <Label Text="Alimentos recientes"
                                          FontSize="12"
                                          TextColor="#7A8B7C"
                                          FontAttributes="Bold"
                                          Margin="5,0"/>

                                   <CollectionView x:Name="HistorialCollectionView"
                                                   EmptyView="Aún no has registrado ningún alimento.">
                                          <CollectionView.ItemTemplate>
                                                 <DataTemplate>
                                                        <Frame BackgroundColor="White"
                                                               CornerRadius="20"
                                                               HasShadow="True"
                                                               BorderColor="Transparent"
                                                               Padding="15"
                                                               Margin="0,0,0,10">
                                                               <Frame.Shadow>
                                                                      <Shadow Brush="#A0AF9E"
                                                                                    Offset="0,4"
                                                                                    Radius="10"
                                                                                    Opacity="0.08"/>
                                                               </Frame.Shadow>
                                                               <Grid ColumnDefinitions="Auto, *, Auto"
                                                                             ColumnSpacing="12">
                                                                      <Border Grid.Column="0"
                                                                              StrokeShape="RoundRectangle 10"
                                                                              StrokeThickness="0"
                                                                              HeightRequest="45"
                                                                              WidthRequest="45"
                                                                              BackgroundColor="#F1F5F1">
                                                                             <Image Source="{Binding Imagen}"
                                                                                    Aspect="AspectFill"/>
                                                                      </Border>
                                                                      <VerticalStackLayout Grid.Column="1"
                                                                                           VerticalOptions="Center"
                                                                                           Spacing="2">
                                                                             <Label Text="{Binding Nombre}"
                                                                                    FontSize="14"
                                                                                    FontAttributes="Bold"
                                                                                    TextColor="#2D3A2F"/>
                                                                             <Label Text="{Binding Marca}"
                                                                                    FontSize="11"
                                                                                    TextColor="#7A8B7C"/>
                                                                      </VerticalStackLayout>
                                                                      <VerticalStackLayout Grid.Column="2"
                                                                                           VerticalOptions="Center"
                                                                                           HorizontalOptions="End"
                                                                                           Spacing="2">
                                                                             <Label Text="{Binding Kcal, StringFormat='{0:F0} kcal'}"
                                                                                    FontSize="13"
                                                                                    FontAttributes="Bold"
                                                                                    TextColor="#8EB497"
                                                                                    HorizontalOptions="End"/>
                                                                             <Label Text="{Binding Proteinas, StringFormat='{0:F1}g prot'}"
                                                                                    FontSize="10"
                                                                                    TextColor="#7A8B7C"
                                                                                    HorizontalOptions="End"/>
                                                                      </VerticalStackLayout>
                                                               </Grid>
                                                        </Frame>
                                                 </DataTemplate>
                                          </CollectionView.ItemTemplate>
                                   </CollectionView>
                            </VerticalStackLayout>

                     </VerticalStackLayout>
              </ScrollView>

              <Frame Grid.Row="1"
                     BackgroundColor="White"
                     CornerRadius="0"
                     Padding="15,10"
                     HasShadow="False"
                     BorderColor="#EEF2EE"
                     VerticalOptions="End">

                     <Grid ColumnDefinitions="*, *, *"
                           MaximumWidthRequest="800"
                           HorizontalOptions="FillAndExpand">

                            <!-- Inicio -->
                            <VerticalStackLayout Grid.Column="0"
                                                 HorizontalOptions="Center"
                                                 Spacing="2">
                                   <VerticalStackLayout.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnInicioTapped"/>
                                   </VerticalStackLayout.GestureRecognizers>
                                   <Label Text="🏠"
                                          FontSize="22"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                   <Label Text="Inicio"
                                          FontSize="11"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                          FontAttributes="Bold"/>
                            </VerticalStackLayout>

                            <!-- Retos -->
                            <VerticalStackLayout Grid.Column="1"
                                                 HorizontalOptions="Center"
                                                 Spacing="2">
                                   <VerticalStackLayout.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnRetosTapped"/>
                                   </VerticalStackLayout.GestureRecognizers>
                                   <Label Text="🏆"
                                          FontSize="22"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                   <Label Text="Retos"
                                          FontSize="11"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                            </VerticalStackLayout>

                            <!-- Perfil -->
                            <VerticalStackLayout Grid.Column="2"
                                                 HorizontalOptions="Center"
                                                 Spacing="2">
                                   <VerticalStackLayout.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnPerfilTapped"/>
                                   </VerticalStackLayout.GestureRecognizers>
                                   <Label Text="👤"
                                          FontSize="22"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                   <Label Text="Perfil"
                                          FontSize="11"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                            </VerticalStackLayout>

                     </Grid>
              </Frame>
       </Grid>
</ContentPage>