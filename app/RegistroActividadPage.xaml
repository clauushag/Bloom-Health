<?xml version="1.0" encoding="utf-8" ?> <!-- Caso de uso de Carlota -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app.RegistroActividadPage"
             BackgroundColor="{AppThemeBinding Light=#F7F9F7, Dark=#121212}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="25" Padding="25,50,25,40">

                <!-- CABECERA -->
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                    <Label Grid.Column="0" Text="←" FontSize="26"
                           TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVolverClicked"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Registro de Actividad"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                        <Label Text="¿Qué ejercicio hiciste hoy?"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- RESUMEN DE HOY -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                    <Frame Grid.Column="0"
                           BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#1A2E1C}"
                           CornerRadius="20" HasShadow="False"
                           BorderColor="Transparent" Padding="10,15">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="🔥" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="Hoy" FontSize="11"
                                   TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                   HorizontalOptions="Center"/>
                            <Label x:Name="LabelKcalHoy" Text="0 kcal"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="#8EB497" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1"
                           BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#1A2E1C}"
                           CornerRadius="20" HasShadow="False"
                           BorderColor="Transparent" Padding="10,15">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="⏱️" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="Duración" FontSize="11"
                                   TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                   HorizontalOptions="Center"/>
                            <Label x:Name="LabelMinutosHoy" Text="0 min"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="#8EB497" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="2"
                           BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#1A2E1C}"
                           CornerRadius="20" HasShadow="False"
                           BorderColor="Transparent" Padding="10,15">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="📈" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="Racha" FontSize="11"
                                   TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                   HorizontalOptions="Center"/>
                            <Label x:Name="LabelRacha" Text="0 días"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="#8EB497" HorizontalOptions="Center"/>
                            <Label x:Name="LabelXpHoy" Text="+0 XP"
                                   FontSize="11" TextColor="#F5C842"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <!-- TARJETAS DE ACTIVIDAD -->
                <VerticalStackLayout Spacing="15">
                    <Label Text="Selecciona tu actividad"
                        FontSize="14" FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                        Margin="5,0"/>

                    <Grid ColumnDefinitions="*, *"
                        RowDefinitions="Auto, Auto, Auto, Auto"
                        ColumnSpacing="15" RowSpacing="15">

                        <!-- Caminar -->
                        <Grid Grid.Row="0" Grid.Column="0">
                            <Frame x:Name="CardCaminar"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                CornerRadius="20" HasShadow="True"
                                BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                                Padding="15">
                                <Frame.Shadow>
                                    <Shadow Brush="#A0AF9E" Offset="0,6" Radius="15" Opacity="0.1"/>
                                </Frame.Shadow>
                                <VerticalStackLayout Spacing="6" InputTransparent="True">
                                    <Label Text="🚶" FontSize="26" Margin="0,0,0,5"/>
                                    <Label Text="Caminar" FontSize="14" FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                    <Label Text="150-200 kcal/30min" FontSize="10"
                                        TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                    <Frame BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#1A2E1C}"
                                        CornerRadius="12" HasShadow="False"
                                        BorderColor="Transparent" Padding="8,4"
                                        HorizontalOptions="Start" Margin="0,5,0,0"
                                        InputTransparent="True">
                                        <Label Text="+20 XP" FontSize="10" FontAttributes="Bold"
                                            TextColor="#8EB497"/>
                                    </Frame>
                                </VerticalStackLayout>
                            </Frame>
                            <Button BackgroundColor="Transparent"
                                    Clicked="OnActividadTapped"
                                    CommandParameter="Caminar"
                                    HorizontalOptions="Fill" VerticalOptions="Fill"/>
                        </Grid>

                        <!-- Correr -->
                        <Grid Grid.Row="0" Grid.Column="1">
                            <Frame x:Name="CardCorrer"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                CornerRadius="20" HasShadow="True"
                                BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                                Padding="15">
                                <Frame.Shadow>
                                    <Shadow Brush="#A0AF9E" Offset="0,6" Radius="15" Opacity="0.1"/>
                                </Frame.Shadow>
                                <VerticalStackLayout Spacing="6" InputTransparent="True">
                                    <Label Text="🏃" FontSize="26" Margin="0,0,0,5"/>
                                    <Label Text="Correr" FontSize="14" FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                    <Label Text="300-400 kcal/30min" FontSize="10"
                                        TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                    <Frame BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#1A2E1C}"
                                        CornerRadius="12" HasShadow="False"
                                        BorderColor="Transparent" Padding="8,4"
                                        HorizontalOptions="Start" Margin="0,5,0,0"
                                        InputTransparent="True">
                                        <Label Text="+35 XP" FontSize="10" FontAttributes="Bold"
                                            TextColor="#8EB497"/>
                                    </Frame>
                                </VerticalStackLayout>
                            </Frame>
                            <Button BackgroundColor="Transparent"
                                    Clicked="OnActividadTapped"
                                    CommandParameter="Correr"
                                    HorizontalOptions="Fill" VerticalOptions="Fill"/>
                        </Grid>

                        <!-- Yoga -->
                        <Grid Grid.Row="1" Grid.Column="0">
                            <Frame x:Name="CardYoga"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                CornerRadius="20" HasShadow="True"
                                BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                                Padding="15">
                                <Frame.Shadow>
                                    <Shadow Brush="#A0AF9E" Offset="0,6" Radius="15" Opacity="0.1"/>
                                </Frame.Shadow>
                                <VerticalStackLayout Spacing="6" InputTransparent="True">
                                    <Label Text="🧘" FontSize="26" Margin="0,0,0,5"/>
                                    <Label Text="Yoga" FontSize="14" FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                    <Label Text="120-180 kcal/30min" FontSize="10"
                                        TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                    <Frame BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#1A2E1C}"
                                        CornerRadius="12" HasShadow="False"
                                        BorderColor="Transparent" Padding="8,4"
                                        HorizontalOptions="Start" Margin="0,5,0,0"
                                        InputTransparent="True">
                                        <Label Text="+25 XP" FontSize="10" FontAttributes="Bold"
                                            TextColor="#8EB497"/>
                                    </Frame>
                                </VerticalStackLayout>
                            </Frame>
                            <Button BackgroundColor="Transparent"
                                    Clicked="OnActividadTapped"
                                    CommandParameter="Yoga"
                                    HorizontalOptions="Fill" VerticalOptions="Fill"/>
                        </Grid>

                        <!-- Ciclismo -->
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Frame x:Name="CardCiclismo"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                CornerRadius="20" HasShadow="True"
                                BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                                Padding="15">
                                <Frame.Shadow>
                                    <Shadow Brush="#A0AF9E" Offset="0,6" Radius="15" Opacity="0.1"/>
                                </Frame.Shadow>
                                <VerticalStackLayout Spacing="6" InputTransparent="True">
                                    <Label Text="🚴" FontSize="26" Margin="0,0,0,5"/>
                                    <Label Text="Ciclismo" FontSize="14" FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                    <Label Text="250-350 kcal/30min" FontSize="10"
                                        TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                    <Frame BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#1A2E1C}"
                                        CornerRadius="12" HasShadow="False"
                                        BorderColor="Transparent" Padding="8,4"
                                        HorizontalOptions="Start" Margin="0,5,0,0"
                                        InputTransparent="True">
                                        <Label Text="+30 XP" FontSize="10" FontAttributes="Bold"
                                            TextColor="#8EB497"/>
                                    </Frame>
                                </VerticalStackLayout>
                            </Frame>
                            <Button BackgroundColor="Transparent"
                                    Clicked="OnActividadTapped"
                                    CommandParameter="Ciclismo"
                                    HorizontalOptions="Fill" VerticalOptions="Fill"/>
                        </Grid>

                        <!-- Natación -->
                        <Grid Grid.Row="2" Grid.Column="0">
                            <Frame x:Name="CardNatacion"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                CornerRadius="20" HasShadow="True"
                                BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                                Padding="15">
                                <Frame.Shadow>
                                    <Shadow Brush="#A0AF9E" Offset="0,6" Radius="15" Opacity="0.1"/>
                                </Frame.Shadow>
                                <VerticalStackLayout Spacing="6" InputTransparent="True">
                                    <Label Text="🏊" FontSize="26" Margin="0,0,0,5"/>
                                    <Label Text="Natación" FontSize="14" FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                    <Label Text="350-450 kcal/30min" FontSize="10"
                                        TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                    <Frame BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#1A2E1C}"
                                        CornerRadius="12" HasShadow="False"
                                        BorderColor="Transparent" Padding="8,4"
                                        HorizontalOptions="Start" Margin="0,5,0,0"
                                        InputTransparent="True">
                                        <Label Text="+40 XP" FontSize="10" FontAttributes="Bold"
                                            TextColor="#8EB497"/>
                                    </Frame>
                                </VerticalStackLayout>
                            </Frame>
                            <Button BackgroundColor="Transparent"
                                    Clicked="OnActividadTapped"
                                    CommandParameter="Natación"
                                    HorizontalOptions="Fill" VerticalOptions="Fill"/>
                        </Grid>

                        <!-- Gimnasio -->
                        <Grid Grid.Row="2" Grid.Column="1">
                            <Frame x:Name="CardGimnasio"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                CornerRadius="20" HasShadow="True"
                                BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                                Padding="15">
                                <Frame.Shadow>
                                    <Shadow Brush="#A0AF9E" Offset="0,6" Radius="15" Opacity="0.1"/>
                                </Frame.Shadow>
                                <VerticalStackLayout Spacing="6" InputTransparent="True">
                                    <Label Text="💪" FontSize="26" Margin="0,0,0,5"/>
                                    <Label Text="Gimnasio" FontSize="14" FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                    <Label Text="200-300 kcal/30min" FontSize="10"
                                        TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                    <Frame BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#1A2E1C}"
                                        CornerRadius="12" HasShadow="False"
                                        BorderColor="Transparent" Padding="8,4"
                                        HorizontalOptions="Start" Margin="0,5,0,0"
                                        InputTransparent="True">
                                        <Label Text="+30 XP" FontSize="10" FontAttributes="Bold"
                                            TextColor="#8EB497"/>
                                    </Frame>
                                </VerticalStackLayout>
                            </Frame>
                            <Button BackgroundColor="Transparent"
                                    Clicked="OnActividadTapped"
                                    CommandParameter="Gimnasio"
                                    HorizontalOptions="Fill" VerticalOptions="Fill"/>
                        </Grid>

                        <!-- Baile -->
                        <Grid Grid.Row="3" Grid.Column="0">
                            <Frame x:Name="CardBaile"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                CornerRadius="20" HasShadow="True"
                                BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                                Padding="15">
                                <Frame.Shadow>
                                    <Shadow Brush="#A0AF9E" Offset="0,6" Radius="15" Opacity="0.1"/>
                                </Frame.Shadow>
                                <VerticalStackLayout Spacing="6" InputTransparent="True">
                                    <Label Text="💃" FontSize="26" Margin="0,0,0,5"/>
                                    <Label Text="Baile" FontSize="14" FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                    <Label Text="180-250 kcal/30min" FontSize="10"
                                        TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                    <Frame BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#1A2E1C}"
                                        CornerRadius="12" HasShadow="False"
                                        BorderColor="Transparent" Padding="8,4"
                                        HorizontalOptions="Start" Margin="0,5,0,0"
                                        InputTransparent="True">
                                        <Label Text="+25 XP" FontSize="10" FontAttributes="Bold"
                                            TextColor="#8EB497"/>
                                    </Frame>
                                </VerticalStackLayout>
                            </Frame>
                            <Button BackgroundColor="Transparent"
                                    Clicked="OnActividadTapped"
                                    CommandParameter="Baile"
                                    HorizontalOptions="Fill" VerticalOptions="Fill"/>
                        </Grid>

                        <!-- Estiramiento -->
                        <Grid Grid.Row="3" Grid.Column="1">
                            <Frame x:Name="CardEstiramiento"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                CornerRadius="20" HasShadow="True"
                                BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                                Padding="15">
                                <Frame.Shadow>
                                    <Shadow Brush="#A0AF9E" Offset="0,6" Radius="15" Opacity="0.1"/>
                                </Frame.Shadow>
                                <VerticalStackLayout Spacing="6" InputTransparent="True">
                                    <Label Text="🤸" FontSize="26" Margin="0,0,0,5"/>
                                    <Label Text="Estiramiento" FontSize="14" FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                    <Label Text="80-120 kcal/30min" FontSize="10"
                                        TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                    <Frame BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#1A2E1C}"
                                        CornerRadius="12" HasShadow="False"
                                        BorderColor="Transparent" Padding="8,4"
                                        HorizontalOptions="Start" Margin="0,5,0,0"
                                        InputTransparent="True">
                                        <Label Text="+15 XP" FontSize="10" FontAttributes="Bold"
                                            TextColor="#8EB497"/>
                                    </Frame>
                                </VerticalStackLayout>
                            </Frame>
                            <Button BackgroundColor="Transparent"
                                    Clicked="OnActividadTapped"
                                    CommandParameter="Estiramiento"
                                    HorizontalOptions="Fill" VerticalOptions="Fill"/>
                        </Grid>

                    </Grid>
                </VerticalStackLayout>
                <!-- RETOS EN PROGRESO -->
                <VerticalStackLayout x:Name="ContenedorRetosEnProgreso"
                                     Spacing="10" IsVisible="False">
                    <Label Text="🏆 Retos en curso"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                           Margin="5,0"/>
                    <Label x:Name="LabelSinRetos"
                           Text="No tienes retos activos. ¡Ve a Retos y acepta uno!"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                           IsVisible="False" Margin="5,0"/>

                    <CollectionView x:Name="RetosEnProgresoCollectionView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                       CornerRadius="16" HasShadow="True"
                                       BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                                       Padding="15" Margin="0,0,0,8">
                                    <Frame.Shadow>
                                        <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.08"/>
                                    </Frame.Shadow>
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Label Grid.Column="0"
                                                   Text="{Binding EmojiCategoria}"
                                                   FontSize="22" VerticalOptions="Center"/>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Nombre}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                                <Label Text="{Binding Descripcion}"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                            </VerticalStackLayout>
                                            <Frame Grid.Column="2"
                                                   BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#2E2A1A}"
                                                   CornerRadius="12" HasShadow="False"
                                                   BorderColor="Transparent"
                                                   Padding="8,4" VerticalOptions="Center">
                                                <Label Text="{Binding Puntos_Recompensa, StringFormat='+{0} XP'}"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="#F5C842"/>
                                            </Frame>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <ProgressBar Grid.Column="0"
                                                         Progress="{Binding PorcentajeProgreso}"
                                                         ProgressColor="#8EB497"
                                                         BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#2C3C2C}"
                                                         VerticalOptions="Center"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding TextoProgreso}"
                                                   FontSize="10"
                                                   TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- FORMULARIO -->
                <VerticalStackLayout x:Name="ContenedorFormulario"
                                     Spacing="15" Margin="0,10,0,0" IsVisible="False">

                    <Label x:Name="LabelActividadSeleccionada"
                           Text="Actividad" FontSize="16" FontAttributes="Bold"
                           TextColor="#8EB497" HorizontalOptions="Center"/>

                    <!-- Duración -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Duración (minutos)" FontSize="12"
                               TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                               FontAttributes="Bold" Margin="5,0"/>
                        <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="20" HasShadow="True"
                               BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                               Padding="15,0">
                            <Frame.Shadow>
                                <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.08"/>
                            </Frame.Shadow>
                            <Entry x:Name="EntryTiempo" Placeholder="Ej: 45"
                                   Keyboard="Numeric"
                                   TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                   FontSize="14"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Calorías -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Calorías quemadas" FontSize="12"
                               TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                               FontAttributes="Bold" Margin="5,0"/>
                        <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="20" HasShadow="True"
                               BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                               Padding="15,0">
                            <Frame.Shadow>
                                <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.08"/>
                            </Frame.Shadow>
                            <Entry x:Name="EntryKcal" Placeholder="Ej: 300"
                                   Keyboard="Numeric"
                                   TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                   FontSize="14"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Distancia -->
                    <VerticalStackLayout x:Name="ContenedorDistancia" Spacing="8">
                        <Label Text="Distancia (km)" FontSize="12"
                               TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                               FontAttributes="Bold" Margin="5,0"/>
                        <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="20" HasShadow="True"
                               BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                               Padding="15,0">
                            <Frame.Shadow>
                                <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.08"/>
                            </Frame.Shadow>
                            <Entry x:Name="EntryDistancia" Placeholder="Ej: 5.2"
                                   Keyboard="Numeric"
                                   TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                   FontSize="14"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Notas -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Notas (opcional)" FontSize="12"
                               TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                               FontAttributes="Bold" Margin="5,0"/>
                        <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="20" HasShadow="True"
                               BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                               Padding="15">
                            <Frame.Shadow>
                                <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.08"/>
                            </Frame.Shadow>
                            <Editor x:Name="EditorNotas"
                                    Placeholder="¿Cómo te sentiste?"
                                    HeightRequest="80"
                                    TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                    PlaceholderColor="#94A696"
                                    FontSize="14" BackgroundColor="Transparent"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Botón guardar -->
                    <Button Text="Guardar Actividad"
                            Clicked="OnGuardarClicked"
                            BackgroundColor="#8EB497" TextColor="White"
                            FontAttributes="Bold" FontSize="16"
                            CornerRadius="25" HeightRequest="55"
                            Margin="0,10,0,10">
                        <Button.Shadow>
                            <Shadow Brush="#8EB497" Offset="0,8" Radius="15" Opacity="0.3"/>
                        </Button.Shadow>
                    </Button>

                </VerticalStackLayout>

                <!-- ACTIVIDADES RECIENTES -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Actividades recientes"
                           FontSize="12" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"
                           Margin="5,0"/>

                    <CollectionView x:Name="HistorialCollectionView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                       CornerRadius="20" HasShadow="True"
                                       BorderColor="{AppThemeBinding Light=Transparent, Dark=#3C3C3C}"
                                       Padding="15" Margin="0,0,0,8">
                                    <Frame.Shadow>
                                        <Shadow Brush="#A0AF9E" Offset="0,4" Radius="10" Opacity="0.08"/>
                                    </Frame.Shadow>
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                                        <Label Grid.Column="0"
                                               Text="{Binding EmojiActividad}"
                                               FontSize="28" VerticalOptions="Center"/>
                                        <VerticalStackLayout Grid.Column="1"
                                                             VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Tipo_Actividad}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                            <Label Text="{Binding ResumenCorto}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                        </VerticalStackLayout>
                                        <Frame Grid.Column="2"
                                               BackgroundColor="{AppThemeBinding Light=#E8F2E9, Dark=#1A2E1C}"
                                               CornerRadius="15" HasShadow="False"
                                               BorderColor="Transparent"
                                               Padding="12,8" VerticalOptions="Center">
                                            <Label Text="{Binding XpTexto}"
                                                   FontSize="12" FontAttributes="Bold"
                                                   TextColor="#8EB497"/>
                                        </Frame>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BARRA NAVEGACIÓN -->
        <Frame Grid.Row="1"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
               CornerRadius="0" Padding="10,6" HasShadow="False"
               BorderColor="{AppThemeBinding Light=#EEF2EE, Dark=#3C3C3C}">
            <Grid ColumnDefinitions="*, *, *"
                  MaximumWidthRequest="800" HorizontalOptions="FillAndExpand">

                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInicioTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="🏠" FontSize="20" HorizontalOptions="Center"/>
                    <Label Text="Inicio" FontSize="11" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRetosTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="🏆" FontSize="20" HorizontalOptions="Center"/>
                    <Label Text="Retos" FontSize="11" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPerfilTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="👤" FontSize="20" HorizontalOptions="Center"/>
                    <Label Text="Perfil" FontSize="11" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                </VerticalStackLayout>

            </Grid>
        </Frame>

    </Grid>
</ContentPage>