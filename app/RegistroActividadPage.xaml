<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app.RegistroActividadPage"
             BackgroundColor="#F7F9F7"
             Shell.NavBarIsVisible="False">

       <Grid>
              <ScrollView>
                     <VerticalStackLayout Spacing="25"
                                          Padding="25,50,25,40">

                            <!-- CABECERA -->
                            <Grid ColumnDefinitions="Auto, *"
                                  ColumnSpacing="15">
                                   <Label Grid.Column="0"
                                          Text="←"
                                          FontSize="26"
                                          TextColor="#2D3A2F"
                                          VerticalOptions="Center">
                                          <Label.GestureRecognizers>
                                                 <TapGestureRecognizer Tapped="OnVolverClicked"/>
                                          </Label.GestureRecognizers>
                                   </Label>
                                   <VerticalStackLayout Grid.Column="1"
                                                        VerticalOptions="Center">
                                          <Label Text="Registro de Actividad"
                                                 FontSize="20"
                                                 FontAttributes="Bold"
                                                 TextColor="#2D3A2F"/>
                                          <Label Text="¿Qué ejercicio hiciste hoy?"
                                                 FontSize="12"
                                                 TextColor="#7A8B7C"/>
                                   </VerticalStackLayout>
                            </Grid>

                            <!-- ── RESUMEN DE HOY ── -->
                            <Grid ColumnDefinitions="*,*,*"
                                  ColumnSpacing="10">

                                   <Frame Grid.Column="0"
                                          BackgroundColor="#E8F2E9"
                                          CornerRadius="20"
                                          HasShadow="False"
                                          BorderColor="Transparent"
                                          Padding="10,15">
                                          <VerticalStackLayout HorizontalOptions="Center"
                                                               Spacing="4">
                                                 <Label Text="🔥"
                                                        FontSize="18"
                                                        HorizontalOptions="Center"/>
                                                 <Label Text="Hoy"
                                                        FontSize="11"
                                                        TextColor="#7A8B7C"
                                                        HorizontalOptions="Center"/>
                                                 <!-- ETIQUETA KCAL QUEMADAS HOY -->
                                                 <Label x:Name="LabelKcalHoy"
                                                        Text="0 kcal"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="#8EB497"
                                                        HorizontalOptions="Center"/>
                                          </VerticalStackLayout>
                                   </Frame>

                                   <Frame Grid.Column="1"
                                          BackgroundColor="#E8F2E9"
                                          CornerRadius="20"
                                          HasShadow="False"
                                          BorderColor="Transparent"
                                          Padding="10,15">
                                          <VerticalStackLayout HorizontalOptions="Center"
                                                               Spacing="4">
                                                 <Label Text="⏱️"
                                                        FontSize="18"
                                                        HorizontalOptions="Center"/>
                                                 <Label Text="Duración"
                                                        FontSize="11"
                                                        TextColor="#7A8B7C"
                                                        HorizontalOptions="Center"/>
                                                 <!-- ETIQUETA MINUTOS TOTALES HOY -->
                                                 <Label x:Name="LabelMinutosHoy"
                                                        Text="0 min"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="#8EB497"
                                                        HorizontalOptions="Center"/>
                                          </VerticalStackLayout>
                                   </Frame>

                                   <Frame Grid.Column="2"
                                          BackgroundColor="#E8F2E9"
                                          CornerRadius="20"
                                          HasShadow="False"
                                          BorderColor="Transparent"
                                          Padding="10,15">
                                          <VerticalStackLayout HorizontalOptions="Center"
                                                               Spacing="4">
                                                 <Label Text="📈"
                                                        FontSize="18"
                                                        HorizontalOptions="Center"/>
                                                 <Label Text="Racha"
                                                        FontSize="11"
                                                        TextColor="#7A8B7C"
                                                        HorizontalOptions="Center"/>
                                                 <!-- ETIQUETA RACHA -->
                                                 <Label x:Name="LabelRacha"
                                                        Text="0 días"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="#8EB497"
                                                        HorizontalOptions="Center"/>
                                                 <!-- XP debajo de la racha -->
                                                 <Label x:Name="LabelXpHoy"
                                                        Text="+0 XP"
                                                        FontSize="11"
                                                        TextColor="#F5C842"
                                                        HorizontalOptions="Center"/>
                                          </VerticalStackLayout>
                                   </Frame>

                            </Grid>

                            <!-- ── TARJETAS DE ACTIVIDAD ── -->
                            <VerticalStackLayout Spacing="15">
                                   <Label Text="Selecciona tu actividad"
                                          FontSize="14"
                                          FontAttributes="Bold"
                                          TextColor="#7A8B7C"
                                          Margin="5,0"/>

                                   <Grid ColumnDefinitions="*, *"
                                         RowDefinitions="Auto, Auto, Auto, Auto"
                                         ColumnSpacing="15"
                                         RowSpacing="15">

                                          <Frame x:Name="CardCaminar"
                                                 Grid.Row="0"
                                                 Grid.Column="0"
                                                 BackgroundColor="White"
                                                 CornerRadius="20"
                                                 HasShadow="True"
                                                 BorderColor="Transparent"
                                                 Padding="15">
                                                 <Frame.Shadow>
                                                        <Shadow Brush="#A0AF9E"
                                                                Offset="0,6"
                                                                Radius="15"
                                                                Opacity="0.1"/>
                                                 </Frame.Shadow>
                                                 <Frame.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnActividadTapped"
                                                                              CommandParameter="Caminar"/>
                                                 </Frame.GestureRecognizers>
                                                 <VerticalStackLayout Spacing="6">
                                                        <Label Text="🚶"
                                                               FontSize="26"
                                                               Margin="0,0,0,5"/>
                                                        <Label Text="Caminar"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"/>
                                                        <Label Text="150-200 kcal/30min"
                                                               FontSize="10"
                                                               TextColor="#7A8B7C"/>
                                                        <Frame BackgroundColor="#E8F2E9"
                                                               CornerRadius="12"
                                                               HasShadow="False"
                                                               BorderColor="Transparent"
                                                               Padding="8,4"
                                                               HorizontalOptions="Start"
                                                               Margin="0,5,0,0">
                                                               <Label Text="+20 XP"
                                                                      FontSize="10"
                                                                      FontAttributes="Bold"
                                                                      TextColor="#8EB497"/>
                                                        </Frame>
                                                 </VerticalStackLayout>
                                          </Frame>

                                          <Frame x:Name="CardCorrer"
                                                 Grid.Row="0"
                                                 Grid.Column="1"
                                                 BackgroundColor="White"
                                                 CornerRadius="20"
                                                 HasShadow="True"
                                                 BorderColor="Transparent"
                                                 Padding="15">
                                                 <Frame.Shadow>
                                                        <Shadow Brush="#A0AF9E"
                                                                Offset="0,6"
                                                                Radius="15"
                                                                Opacity="0.1"/>
                                                 </Frame.Shadow>
                                                 <Frame.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnActividadTapped"
                                                                              CommandParameter="Correr"/>
                                                 </Frame.GestureRecognizers>
                                                 <VerticalStackLayout Spacing="6">
                                                        <Label Text="🏃"
                                                               FontSize="26"
                                                               Margin="0,0,0,5"/>
                                                        <Label Text="Correr"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"/>
                                                        <Label Text="300-400 kcal/30min"
                                                               FontSize="10"
                                                               TextColor="#7A8B7C"/>
                                                        <Frame BackgroundColor="#E8F2E9"
                                                               CornerRadius="12"
                                                               HasShadow="False"
                                                               BorderColor="Transparent"
                                                               Padding="8,4"
                                                               HorizontalOptions="Start"
                                                               Margin="0,5,0,0">
                                                               <Label Text="+35 XP"
                                                                      FontSize="10"
                                                                      FontAttributes="Bold"
                                                                      TextColor="#8EB497"/>
                                                        </Frame>
                                                 </VerticalStackLayout>
                                          </Frame>

                                          <Frame x:Name="CardYoga"
                                                 Grid.Row="1"
                                                 Grid.Column="0"
                                                 BackgroundColor="White"
                                                 CornerRadius="20"
                                                 HasShadow="True"
                                                 BorderColor="Transparent"
                                                 Padding="15">
                                                 <Frame.Shadow>
                                                        <Shadow Brush="#A0AF9E"
                                                                Offset="0,6"
                                                                Radius="15"
                                                                Opacity="0.1"/>
                                                 </Frame.Shadow>
                                                 <Frame.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnActividadTapped"
                                                                              CommandParameter="Yoga"/>
                                                 </Frame.GestureRecognizers>
                                                 <VerticalStackLayout Spacing="6">
                                                        <Label Text="🧘"
                                                               FontSize="26"
                                                               Margin="0,0,0,5"/>
                                                        <Label Text="Yoga"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"/>
                                                        <Label Text="120-180 kcal/30min"
                                                               FontSize="10"
                                                               TextColor="#7A8B7C"/>
                                                        <Frame BackgroundColor="#E8F2E9"
                                                               CornerRadius="12"
                                                               HasShadow="False"
                                                               BorderColor="Transparent"
                                                               Padding="8,4"
                                                               HorizontalOptions="Start"
                                                               Margin="0,5,0,0">
                                                               <Label Text="+25 XP"
                                                                      FontSize="10"
                                                                      FontAttributes="Bold"
                                                                      TextColor="#8EB497"/>
                                                        </Frame>
                                                 </VerticalStackLayout>
                                          </Frame>

                                          <Frame x:Name="CardCiclismo"
                                                 Grid.Row="1"
                                                 Grid.Column="1"
                                                 BackgroundColor="White"
                                                 CornerRadius="20"
                                                 HasShadow="True"
                                                 BorderColor="Transparent"
                                                 Padding="15">
                                                 <Frame.Shadow>
                                                        <Shadow Brush="#A0AF9E"
                                                                Offset="0,6"
                                                                Radius="15"
                                                                Opacity="0.1"/>
                                                 </Frame.Shadow>
                                                 <Frame.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnActividadTapped"
                                                                              CommandParameter="Ciclismo"/>
                                                 </Frame.GestureRecognizers>
                                                 <VerticalStackLayout Spacing="6">
                                                        <Label Text="🚴"
                                                               FontSize="26"
                                                               Margin="0,0,0,5"/>
                                                        <Label Text="Ciclismo"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"/>
                                                        <Label Text="250-350 kcal/30min"
                                                               FontSize="10"
                                                               TextColor="#7A8B7C"/>
                                                        <Frame BackgroundColor="#E8F2E9"
                                                               CornerRadius="12"
                                                               HasShadow="False"
                                                               BorderColor="Transparent"
                                                               Padding="8,4"
                                                               HorizontalOptions="Start"
                                                               Margin="0,5,0,0">
                                                               <Label Text="+30 XP"
                                                                      FontSize="10"
                                                                      FontAttributes="Bold"
                                                                      TextColor="#8EB497"/>
                                                        </Frame>
                                                 </VerticalStackLayout>
                                          </Frame>

                                          <Frame x:Name="CardNatacion"
                                                 Grid.Row="2"
                                                 Grid.Column="0"
                                                 BackgroundColor="White"
                                                 CornerRadius="20"
                                                 HasShadow="True"
                                                 BorderColor="Transparent"
                                                 Padding="15">
                                                 <Frame.Shadow>
                                                        <Shadow Brush="#A0AF9E"
                                                                Offset="0,6"
                                                                Radius="15"
                                                                Opacity="0.1"/>
                                                 </Frame.Shadow>
                                                 <Frame.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnActividadTapped"
                                                                              CommandParameter="Natación"/>
                                                 </Frame.GestureRecognizers>
                                                 <VerticalStackLayout Spacing="6">
                                                        <Label Text="🏊"
                                                               FontSize="26"
                                                               Margin="0,0,0,5"/>
                                                        <Label Text="Natación"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"/>
                                                        <Label Text="350-450 kcal/30min"
                                                               FontSize="10"
                                                               TextColor="#7A8B7C"/>
                                                        <Frame BackgroundColor="#E8F2E9"
                                                               CornerRadius="12"
                                                               HasShadow="False"
                                                               BorderColor="Transparent"
                                                               Padding="8,4"
                                                               HorizontalOptions="Start"
                                                               Margin="0,5,0,0">
                                                               <Label Text="+40 XP"
                                                                      FontSize="10"
                                                                      FontAttributes="Bold"
                                                                      TextColor="#8EB497"/>
                                                        </Frame>
                                                 </VerticalStackLayout>
                                          </Frame>

                                          <Frame x:Name="CardGimnasio"
                                                 Grid.Row="2"
                                                 Grid.Column="1"
                                                 BackgroundColor="White"
                                                 CornerRadius="20"
                                                 HasShadow="True"
                                                 BorderColor="Transparent"
                                                 Padding="15">
                                                 <Frame.Shadow>
                                                        <Shadow Brush="#A0AF9E"
                                                                Offset="0,6"
                                                                Radius="15"
                                                                Opacity="0.1"/>
                                                 </Frame.Shadow>
                                                 <Frame.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnActividadTapped"
                                                                              CommandParameter="Gimnasio"/>
                                                 </Frame.GestureRecognizers>
                                                 <VerticalStackLayout Spacing="6">
                                                        <Label Text="💪"
                                                               FontSize="26"
                                                               Margin="0,0,0,5"/>
                                                        <Label Text="Gimnasio"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"/>
                                                        <Label Text="200-300 kcal/30min"
                                                               FontSize="10"
                                                               TextColor="#7A8B7C"/>
                                                        <Frame BackgroundColor="#E8F2E9"
                                                               CornerRadius="12"
                                                               HasShadow="False"
                                                               BorderColor="Transparent"
                                                               Padding="8,4"
                                                               HorizontalOptions="Start"
                                                               Margin="0,5,0,0">
                                                               <Label Text="+30 XP"
                                                                      FontSize="10"
                                                                      FontAttributes="Bold"
                                                                      TextColor="#8EB497"/>
                                                        </Frame>
                                                 </VerticalStackLayout>
                                          </Frame>

                                          <Frame x:Name="CardBaile"
                                                 Grid.Row="3"
                                                 Grid.Column="0"
                                                 BackgroundColor="White"
                                                 CornerRadius="20"
                                                 HasShadow="True"
                                                 BorderColor="Transparent"
                                                 Padding="15">
                                                 <Frame.Shadow>
                                                        <Shadow Brush="#A0AF9E"
                                                                Offset="0,6"
                                                                Radius="15"
                                                                Opacity="0.1"/>
                                                 </Frame.Shadow>
                                                 <Frame.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnActividadTapped"
                                                                              CommandParameter="Baile"/>
                                                 </Frame.GestureRecognizers>
                                                 <VerticalStackLayout Spacing="6">
                                                        <Label Text="💃"
                                                               FontSize="26"
                                                               Margin="0,0,0,5"/>
                                                        <Label Text="Baile"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"/>
                                                        <Label Text="180-250 kcal/30min"
                                                               FontSize="10"
                                                               TextColor="#7A8B7C"/>
                                                        <Frame BackgroundColor="#E8F2E9"
                                                               CornerRadius="12"
                                                               HasShadow="False"
                                                               BorderColor="Transparent"
                                                               Padding="8,4"
                                                               HorizontalOptions="Start"
                                                               Margin="0,5,0,0">
                                                               <Label Text="+25 XP"
                                                                      FontSize="10"
                                                                      FontAttributes="Bold"
                                                                      TextColor="#8EB497"/>
                                                        </Frame>
                                                 </VerticalStackLayout>
                                          </Frame>

                                          <Frame x:Name="CardEstiramiento"
                                                 Grid.Row="3"
                                                 Grid.Column="1"
                                                 BackgroundColor="White"
                                                 CornerRadius="20"
                                                 HasShadow="True"
                                                 BorderColor="Transparent"
                                                 Padding="15">
                                                 <Frame.Shadow>
                                                        <Shadow Brush="#A0AF9E"
                                                                Offset="0,6"
                                                                Radius="15"
                                                                Opacity="0.1"/>
                                                 </Frame.Shadow>
                                                 <Frame.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnActividadTapped"
                                                                              CommandParameter="Estiramiento"/>
                                                 </Frame.GestureRecognizers>
                                                 <VerticalStackLayout Spacing="6">
                                                        <Label Text="🤸"
                                                               FontSize="26"
                                                               Margin="0,0,0,5"/>
                                                        <Label Text="Estiramiento"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="#2D3A2F"/>
                                                        <Label Text="80-120 kcal/30min"
                                                               FontSize="10"
                                                               TextColor="#7A8B7C"/>
                                                        <Frame BackgroundColor="#E8F2E9"
                                                               CornerRadius="12"
                                                               HasShadow="False"
                                                               BorderColor="Transparent"
                                                               Padding="8,4"
                                                               HorizontalOptions="Start"
                                                               Margin="0,5,0,0">
                                                               <Label Text="+15 XP"
                                                                      FontSize="10"
                                                                      FontAttributes="Bold"
                                                                      TextColor="#8EB497"/>
                                                        </Frame>
                                                 </VerticalStackLayout>
                                          </Frame>

                                   </Grid>
                            </VerticalStackLayout>

                            <!-- ── RETOS EN PROGRESO ── -->
                            <VerticalStackLayout x:Name="ContenedorRetosEnProgreso"
                                                 Spacing="10"
                                          IsVisible="False">

                                   <Label Text="🏆 Retos en curso"
                                          FontSize="14"
                                                 FontAttributes="Bold"
                                          TextColor="#7A8B7C"
                                                 Margin="5,0"/>

                                   <Label x:Name="LabelSinRetos"
                                          Text="No tienes retos activos. ¡Ve a Retos y acepta uno!"
                                          FontSize="12"
                                                 TextColor="#7A8B7C"
                                          IsVisible="False"
                                                 Margin="5,0"/>

                                   <CollectionView x:Name="RetosEnProgresoCollectionView">
                                          <CollectionView.ItemTemplate>
                                                 <DataTemplate>
                                                        <Frame BackgroundColor="White"
                                                                      CornerRadius="16"
                                                               HasShadow="True"
                                                                      BorderColor="Transparent"
                                                               Padding="15"
                                                                      Margin="0,0,0,8">
                                                               <Frame.Shadow>
                                                                      <Shadow Brush="#A0AF9E"
                                                                                    Offset="0,4"
                                                                                    Radius="10"
                                                                                    Opacity="0.08"/>
                                                               </Frame.Shadow>
                                                               <VerticalStackLayout Spacing="6">

                                                                      <!-- Nombre y XP -->
                                                                      <Grid ColumnDefinitions="Auto,*,Auto"
                                                                                    ColumnSpacing="10">
                                                                             <Label Grid.Column="0"
                                                                                    Text="{Binding EmojiCategoria}"
                                                                                    FontSize="22"
                                                                                           VerticalOptions="Center"/>
                                                                             <VerticalStackLayout Grid.Column="1"
                                                                                                  VerticalOptions="Center"
                                                                                           Spacing="2">
                                                                                    <Label Text="{Binding Nombre}"
                                                                                           FontSize="13"
                                                                                                  FontAttributes="Bold"
                                                                                           TextColor="#2D3A2F"/>
                                                                                    <Label Text="{Binding Descripcion}"
                                                                                           FontSize="11"
                                                                                                  TextColor="#7A8B7C"/>
                                                                             </VerticalStackLayout>
                                                                             <Frame Grid.Column="2"
                                                                                    BackgroundColor="#FFF8E1"
                                                                                           CornerRadius="12"
                                                                                    HasShadow="False"
                                                                                           BorderColor="Transparent"
                                                                                    Padding="8,4"
                                                                                           VerticalOptions="Center">
                                                                                    <Label Text="{Binding Puntos_Recompensa,
                                              StringFormat='+{0} XP'}"
                                                                                           FontSize="11"
                                                                                                  FontAttributes="Bold"
                                                                                           TextColor="#F5C842"/>
                                                                             </Frame>
                                                                      </Grid>

                                                                      <!-- Barra de progreso -->
                                                                      <Grid ColumnDefinitions="*,Auto"
                                                                                    ColumnSpacing="8">
                                                                             <ProgressBar Grid.Column="0"
                                                                                          Progress="{Binding PorcentajeProgreso}"
                                                                                          ProgressColor="#8EB497"
                                                                                          BackgroundColor="#E8F2E9"
                                                                                          VerticalOptions="Center"/>
                                                                             <Label Grid.Column="1"
                                                                                    Text="{Binding TextoProgreso}"
                                                                                    FontSize="10"
                                                                                           TextColor="#7A8B7C"
                                                                                    VerticalOptions="Center"/>
                                                                      </Grid>

                                                               </VerticalStackLayout>
                                                        </Frame>
                                                 </DataTemplate>
                                          </CollectionView.ItemTemplate>
                                   </CollectionView>

                            </VerticalStackLayout>

                            <!-- ── FORMULARIO ── -->
                            <VerticalStackLayout x:Name="ContenedorFormulario"
                                                 Spacing="15"
                                                 Margin="0,10,0,0"
                                                 IsVisible="False">

                                   <Label x:Name="LabelActividadSeleccionada"
                                          Text="Actividad"
                                          FontSize="16"
                                          FontAttributes="Bold"
                                          TextColor="#8EB497"
                                          HorizontalOptions="Center"/>

                                   <!-- Duración -->
                                   <VerticalStackLayout Spacing="8">
                                          <Label Text="Duración (minutos)"
                                                 FontSize="12"
                                                 TextColor="#7A8B7C"
                                                 FontAttributes="Bold"
                                                 Margin="5,0"/>
                                          <Frame BackgroundColor="White"
                                                 CornerRadius="20"
                                                 HasShadow="True"
                                                 BorderColor="Transparent"
                                                 Padding="15,0">
                                                 <Frame.Shadow>
                                                        <Shadow Brush="#A0AF9E"
                                                                Offset="0,4"
                                                                Radius="10"
                                                                Opacity="0.08"/>
                                                 </Frame.Shadow>
                                                 <!-- ENTRY DURACIÓN -->
                                                 <Entry x:Name="EntryTiempo"
                                                        Placeholder="Ej: 45"
                                                        Keyboard="Numeric"
                                                        TextColor="#2D3A2F"
                                                        FontSize="14"/>
                                          </Frame>
                                   </VerticalStackLayout>

                                   <!-- Calorías quemadas -->
                                   <VerticalStackLayout Spacing="8">
                                          <Label Text="Calorías quemadas"
                                                 FontSize="12"
                                                 TextColor="#7A8B7C"
                                                 FontAttributes="Bold"
                                                 Margin="5,0"/>
                                          <Frame BackgroundColor="White"
                                                 CornerRadius="20"
                                                 HasShadow="True"
                                                 BorderColor="Transparent"
                                                 Padding="15,0">
                                                 <Frame.Shadow>
                                                        <Shadow Brush="#A0AF9E"
                                                                Offset="0,4"
                                                                Radius="10"
                                                                Opacity="0.08"/>
                                                 </Frame.Shadow>
                                                 <!-- ENTRY KCAL -->
                                                 <Entry x:Name="EntryKcal"
                                                        Placeholder="Ej: 300"
                                                        Keyboard="Numeric"
                                                        TextColor="#2D3A2F"
                                                        FontSize="14"/>
                                          </Frame>
                                   </VerticalStackLayout>

                                   <!-- Distancia (oculto para Yoga, Gimnasio, Baile, Estiramiento) -->
                                   <VerticalStackLayout x:Name="ContenedorDistancia"
                                                        Spacing="8">
                                          <Label Text="Distancia (km)"
                                                 FontSize="12"
                                                 TextColor="#7A8B7C"
                                                 FontAttributes="Bold"
                                                 Margin="5,0"/>
                                          <Frame BackgroundColor="White"
                                                 CornerRadius="20"
                                                 HasShadow="True"
                                                 BorderColor="Transparent"
                                                 Padding="15,0">
                                                 <Frame.Shadow>
                                                        <Shadow Brush="#A0AF9E"
                                                                Offset="0,4"
                                                                Radius="10"
                                                                Opacity="0.08"/>
                                                 </Frame.Shadow>
                                                 <!-- ENTRY DISTANCIA -->
                                                 <Entry x:Name="EntryDistancia"
                                                        Placeholder="Ej: 5.2"
                                                        Keyboard="Numeric"
                                                        TextColor="#2D3A2F"
                                                        FontSize="14"/>
                                          </Frame>
                                   </VerticalStackLayout>

                                   <!-- Notas (opcional, no se guarda en BD por ahora) -->
                                   <VerticalStackLayout Spacing="8">
                                          <Label Text="Notas (opcional)"
                                                 FontSize="12"
                                                 TextColor="#7A8B7C"
                                                 FontAttributes="Bold"
                                                 Margin="5,0"/>
                                          <Frame BackgroundColor="White"
                                                 CornerRadius="20"
                                                 HasShadow="True"
                                                 BorderColor="Transparent"
                                                 Padding="15">
                                                 <Frame.Shadow>
                                                        <Shadow Brush="#A0AF9E"
                                                                Offset="0,4"
                                                                Radius="10"
                                                                Opacity="0.08"/>
                                                 </Frame.Shadow>
                                                 <Editor x:Name="EditorNotas"
                                                         Placeholder="¿Cómo te sentiste?"
                                                         HeightRequest="80"
                                                         TextColor="#2D3A2F"
                                                         PlaceholderColor="#94A696"
                                                         FontSize="14"
                                                         BackgroundColor="Transparent"/>
                                          </Frame>
                                   </VerticalStackLayout>

                                   <!-- Botón guardar -->
                                   <Button Text="Guardar Actividad"
                                           Clicked="OnGuardarClicked"
                                           BackgroundColor="#8EB497"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           CornerRadius="25"
                                           HeightRequest="55"
                                           Margin="0,10,0,10">
                                          <Button.Shadow>
                                                 <Shadow Brush="#8EB497"
                                                         Offset="0,8"
                                                         Radius="15"
                                                         Opacity="0.3"/>
                                          </Button.Shadow>
                                   </Button>

                            </VerticalStackLayout>

                            <!-- ── ACTIVIDADES RECIENTES (datos reales) ── -->
                            <VerticalStackLayout Spacing="12">
                                   <Label Text="Actividades recientes"
                                          FontSize="12"
                                          FontAttributes="Bold"
                                          TextColor="#7A8B7C"
                                          Margin="5,0"/>

                                   <CollectionView x:Name="HistorialCollectionView">
                                          <CollectionView.ItemTemplate>
                                                 <DataTemplate>
                                                        <Frame BackgroundColor="White"
                                                               CornerRadius="20"
                                                               HasShadow="True"
                                                               BorderColor="Transparent"
                                                               Padding="15"
                                                               Margin="0,0,0,8">
                                                               <Frame.Shadow>
                                                                      <Shadow Brush="#A0AF9E"
                                                                              Offset="0,4"
                                                                              Radius="10"
                                                                              Opacity="0.08"/>
                                                               </Frame.Shadow>
                                                               <Grid ColumnDefinitions="Auto, *, Auto"
                                                                     ColumnSpacing="15">
                                                                      <Label Grid.Column="0"
                                                                             Text="{Binding EmojiActividad}"
                                                                             FontSize="28"
                                                                             VerticalOptions="Center"/>
                                                                      <VerticalStackLayout Grid.Column="1"
                                                                                           VerticalOptions="Center"
                                                                                           Spacing="2">
                                                                             <Label Text="{Binding Tipo_Actividad}"
                                                                                    FontSize="14"
                                                                                    FontAttributes="Bold"
                                                                                    TextColor="#2D3A2F"/>
                                                                             <Label Text="{Binding ResumenCorto}"
                                                                                    FontSize="11"
                                                                                    TextColor="#7A8B7C"/>
                                                                      </VerticalStackLayout>
                                                                      <Frame Grid.Column="2"
                                                                             BackgroundColor="#E8F2E9"
                                                                             CornerRadius="15"
                                                                             HasShadow="False"
                                                                             BorderColor="Transparent"
                                                                             Padding="12,8"
                                                                             VerticalOptions="Center">
                                                                             <Label Text="{Binding XpTexto}"
                                                                                    FontSize="12"
                                                                                    FontAttributes="Bold"
                                                                                    TextColor="#8EB497"/>
                                                                      </Frame>
                                                               </Grid>
                                                        </Frame>
                                                 </DataTemplate>
                                          </CollectionView.ItemTemplate>
                                   </CollectionView>

                            </VerticalStackLayout>

                     </VerticalStackLayout>
              </ScrollView>

              <!-- BARRA NAVEGACIÓN -->
              <Frame BackgroundColor="White"
                     CornerRadius="0"
                     Padding="10,6"
                     HasShadow="False"
                     BorderColor="#EEF2EE"
                     VerticalOptions="End">
                     <Grid ColumnDefinitions="*, *, *"
                           MaximumWidthRequest="800"
                           HorizontalOptions="FillAndExpand">

                            <VerticalStackLayout Grid.Column="0"
                                                 HorizontalOptions="Center"
                                                 Spacing="2">
                                   <VerticalStackLayout.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnInicioTapped"/>
                                   </VerticalStackLayout.GestureRecognizers>
                                   <Label Text="🏠"
                                          FontSize="20"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"/>
                                   <Label Text="Inicio"
                                          FontSize="11"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#2D3A2F, Dark=#E1EFE3}"
                                          FontAttributes="Bold"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 HorizontalOptions="Center"
                                                 Spacing="2">
                                   <VerticalStackLayout.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnRetosTapped"/>
                                   </VerticalStackLayout.GestureRecognizers>
                                   <Label Text="🏆"
                                          FontSize="20"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                   <Label Text="Retos"
                                          FontSize="11"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2"
                                                 HorizontalOptions="Center"
                                                 Spacing="2">
                                   <VerticalStackLayout.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnPerfilTapped"/>
                                   </VerticalStackLayout.GestureRecognizers>
                                   <Label Text="👤"
                                          FontSize="20"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                                   <Label Text="Perfil"
                                          FontSize="11"
                                          HorizontalOptions="Center"
                                          TextColor="{AppThemeBinding Light=#7A8B7C, Dark=#A0AF9E}"/>
                            </VerticalStackLayout>

                     </Grid>
              </Frame>

       </Grid>
</ContentPage>